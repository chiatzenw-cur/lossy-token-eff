+# LOSSY-VERIFICATION PILOT PATCH (not upstream vLLM).
+#
+# Mentored Decoding, Tran-Thien 2023, "An optimal lossy variant of speculative
+# decoding" -- the beta=1 variant used in Narasimhan et al. 2025 (Appendix
+# F.6) and named "mentored-dec" in the taxonomy of Xia et al. 2026
+# (arXiv:2607.08690, Table 2 / Eq. 9). Its rejection target is
+#     pi_rej(v) = min(p(v) / (1 - alpha), 1)
+# substituted into the ordinary ratio test in place of p(x), with residual
+# sampling on rejection left untouched (pi_res(v) = p(v) -- this patch does
+# NOT touch recovery/residual sampling, only the accept/reject test):
+#     accept iff  pi_rej(x) / q(x) >= u
+#              =  min(p(x)/(1-alpha), 1) / q(x) >= u
+# alpha in [0, 1) is the taxonomy's own relaxation-parameter symbol (their
+# glossary: "meaning is method-dependent"); Tran-Thien's own separate beta
+# parameter is fixed at 1 throughout and does not appear here.
+#
+# Implementation identity, not approximation: writing lam = 1 - alpha, this
+# repo computes the *unclamped* ratio p(x)/(lam*q(x)) and compares directly to
+# u, rather than first clamping min(p(x)/lam, 1) and then dividing by q(x).
+# These give bit-identical accept decisions for any valid probabilities (q(x)
+# <= 1 always, so 1/q(x) >= 1, so both formulations saturate to "always
+# accept" together whenever p(x)/lam > 1) -- confirmed by case analysis, not
+# just empirically. alpha=0 (lam=1) makes the division a no-op: pi_rej(x) ==
+# p(x) exactly, recovering strict spec-dec bit-for-bit.
+#
+# History: an earlier version of this patch exposed lam directly under the
+# name "lenience factor" (Leviathan et al. 2023's own historical term for a
+# similarly-shaped knob), and before that, misnamed the knob "beta" -- which
+# collides with Tran-Thien's real, different, fixed-at-1 beta. This version
+# exposes alpha, the taxonomy's own symbol, as the primary external knob and
+# derives lam = 1 - alpha internally, so the CLI/config surface matches
+# arXiv:2607.08690 Table 2 directly rather than requiring a mental 1-alpha
+# translation at the call site.
+#
+# This is the V1 model-runner path. vLLM 0.26.0 ships two runners; which one is
+# live depends on VllmConfig.use_v2_model_runner, and for this config it is V1,
+# so patching only the V2 kernel in gpu/spec_decode/rejection_sampler_utils.py
+# had no effect at all. Both are patched to avoid depending on that choice.
+#
+# alpha comes from a file, not the environment: vLLM spawns EngineCore with a
+# sanitised environment and env vars never reach the sampler. The path is
+# uid-scoped under /tmp AND repo-scoped (lossy-token-eff, not the sibling
+# lossy-spec-decode-repetition's lossy-spec-decode- prefix) so that a server
+# from either repo cannot pick up the other repo's stale knob value if both
+# ever run on this box at once.
+_MENTORED_DEC_FORCE_COMMIT_ALPHA_FILE = f"/tmp/lossy-token-eff-mentored-dec-force-commit-alpha-{os.getuid()}"
+try:
+    with open(_MENTORED_DEC_FORCE_COMMIT_ALPHA_FILE) as _f:
+        _MENTORED_DEC_ALPHA = float(_f.read().strip())
+    _MENTORED_DEC_ALPHA_SOURCE = _MENTORED_DEC_FORCE_COMMIT_ALPHA_FILE
+except (OSError, ValueError):
+    _MENTORED_DEC_ALPHA = 0.0  # lam == 1.0 -> strict spec-dec exactly
+    _MENTORED_DEC_ALPHA_SOURCE = f"default, no readable {_MENTORED_DEC_FORCE_COMMIT_ALPHA_FILE}"
+if not 0.0 <= _MENTORED_DEC_ALPHA < 1.0:
+    raise ValueError(f"mentored-dec alpha must be in [0, 1); got {_MENTORED_DEC_ALPHA}")
+_MENTORED_DEC_LAM = 1.0 - _MENTORED_DEC_ALPHA
+print(
+    f"[MENTORED-DEC PATCH] pid={os.getpid()} alpha={_MENTORED_DEC_ALPHA} "
+    f"(lam={_MENTORED_DEC_LAM}) ({_MENTORED_DEC_ALPHA_SOURCE})",
+    file=sys.stderr,
+    flush=True,
+)
+
+
+# FORCE-COMMIT (analysis/semantic_guard/, not upstream vLLM, not part of Xia
+# et al.'s taxonomy). Ported verbatim from spec-casc-tok-force-commit (see
+# that patch's own module comment for the full "never commits" failure-mode
+# writeup and rationale) onto MENTORED-DEC's own base. Mechanism is
+# method-agnostic: one-hot target_probs onto the next token of the fixed
+# 6-token harmony final-channel-open boundary once cumulative real emitted
+# tokens cross a threshold without that boundary having occurred naturally,
+# applied BEFORE this method's own relaxation math reads target_probs so it
+# flows through whatever this method does with it. mentored-dec's accept test is an unconditional scaled ratio (no switch branch), so this is a direct port -- no defer_mask to OR into. Own alpha-knob file (not mentored-dec's plain one) to avoid the same cross-patch alpha-aliasing bug class spec-casc-tok-force-commit's own module comment documents.
+_MENTORED_DEC_FORCE_COMMIT_THRESHOLD_FILE = f"/tmp/lossy-token-eff-mentored-dec-force-commit-threshold-{os.getuid()}"
+try:
+    with open(_MENTORED_DEC_FORCE_COMMIT_THRESHOLD_FILE) as _f:
+        _MENTORED_DEC_FORCE_COMMIT_THRESHOLD = int(float(_f.read().strip()))
+except (OSError, ValueError):
+    _MENTORED_DEC_FORCE_COMMIT_THRESHOLD = 28000
+print(
+    f"[MENTORED-DEC-FORCE-COMMIT PATCH] pid={os.getpid()} "
+    f"threshold={_MENTORED_DEC_FORCE_COMMIT_THRESHOLD}",
+    file=sys.stderr,
+    flush=True,
+)
+
+_MENTORED_DEC_FINAL_OPEN_PATTERN = [200007, 200006, 173781, 200005, 17196, 200008]
+_MENTORED_DEC_FORCE_COMMIT_WARMUP_BATCH_THRESHOLD = 8
+_MENTORED_DEC_FORCE_COMMIT_HISTORY_MAXLEN = 64
+
+_FORCE_COMMIT_REQ_IDS: list[str] | None = None  # set per sampling step by the model runner
+_MENTORED_DEC_FORCE_COMMIT_STATES: dict[str, dict[str, object]] = {}
+
+
+def _mentored_force_commit_state() -> dict[str, object]:
+    key = _FORCE_COMMIT_REQ_IDS[0] if _FORCE_COMMIT_REQ_IDS else ""
+    if key not in _MENTORED_DEC_FORCE_COMMIT_STATES:
+        _MENTORED_DEC_FORCE_COMMIT_STATES[key] = {"token_count": 0, "final_opened": False, "tail": []}
+    return _MENTORED_DEC_FORCE_COMMIT_STATES[key]
+
+
+def _mentored_dec_force_commit_pattern_progress(tail: list[int]) -> int:
+    n = len(_MENTORED_DEC_FINAL_OPEN_PATTERN)
+    for k in range(min(n, len(tail)), 0, -1):
+        if tail[-k:] == _MENTORED_DEC_FINAL_OPEN_PATTERN[:k]:
+            return k
+    return 0
+
+
+def _mentored_dec_force_commit_apply(target_probs, num_draft_tokens, cu_num_draft_tokens):
+    """Returns (possibly-forced target_probs, force_mask). Identical logic
+    to spec-casc-tok-force-commit's own _force_commit_apply -- see that
+    patch's docstring for the start0-only-forcing bug this already avoids
+    by forcing every still-unforced pattern position available each round."""
+    state = _mentored_force_commit_state()
+    num_tokens = target_probs.shape[0]
+    force_mask = torch.zeros(num_tokens, dtype=torch.bool, device=target_probs.device)
+    if state["final_opened"] or state["token_count"] < _MENTORED_DEC_FORCE_COMMIT_THRESHOLD:
+        return target_probs, force_mask
+    if not num_draft_tokens or num_draft_tokens[0] == 0:
+        return target_probs, force_mask
+    end0 = int(cu_num_draft_tokens[0].item())
+    n0 = num_draft_tokens[0]
+    start0 = end0 - n0
+    progress = _mentored_dec_force_commit_pattern_progress(state["tail"])
+    remaining = len(_MENTORED_DEC_FINAL_OPEN_PATTERN) - progress
+    if remaining <= 0:
+        return target_probs, force_mask
+    n_to_force = min(n0, remaining)
+    forced = target_probs.clone()
+    for i in range(n_to_force):
+        pos = start0 + i
+        forced_token = _MENTORED_DEC_FINAL_OPEN_PATTERN[progress + i]
+        forced[pos] = 0.0
+        forced[pos, forced_token] = 1.0
+        force_mask[pos] = True
+    return forced, force_mask
+
+
+def _mentored_dec_force_commit_update(output_token_ids, num_draft_tokens, batch_size) -> None:
+    if batch_size > _MENTORED_DEC_FORCE_COMMIT_WARMUP_BATCH_THRESHOLD:
+        _MENTORED_DEC_FORCE_COMMIT_STATES.clear()
+        return
+    state = _mentored_force_commit_state()
+    row = output_token_ids[0].tolist()
+    emitted = [t for t in row if t != PLACEHOLDER_TOKEN_ID]
+    if not emitted:
+        return
+    state["token_count"] = int(state["token_count"]) + len(emitted)
+    if state["final_opened"]:
+        return
+    tail = list(state["tail"]) + emitted
+    if len(tail) > _MENTORED_DEC_FORCE_COMMIT_HISTORY_MAXLEN:
+        del tail[: len(tail) - _MENTORED_DEC_FORCE_COMMIT_HISTORY_MAXLEN]
+    state["tail"] = tail
+    if _mentored_dec_force_commit_pattern_progress(tail) >= len(_MENTORED_DEC_FINAL_OPEN_PATTERN):
+        state["final_opened"] = True
+
