+def _jn_update(output_token_ids: torch.Tensor, batch_size: int) -> None:
+    """Cross-round persistence AND the only place mode actually
+    transitions, gated on real emitted tokens -- same discipline as
+    every other stateful patch in this repo. Writes the resulting
+    nudge_remaining to the shared file for gpu_model_runner.py's own
+    half to read next round."""
+    state = _JN_STATE
+    if batch_size > _JN_WARMUP_BATCH_THRESHOLD:
+        state["committed_before"] = 0
+        state["nudge_remaining"] = 0
+        state["pending_nudge"] = False
+        _jn_write_nudge_remaining(0)
+        return
+    row = output_token_ids[0].tolist()
+    emitted = [t for t in row if t != PLACEHOLDER_TOKEN_ID]
+    if not emitted:
+        return
+    state["committed_before"] = int(state["committed_before"]) + len(emitted)
+
+    if state["nudge_remaining"]:  # type: ignore[truthy-bool]
+        state["nudge_remaining"] = int(state["nudge_remaining"]) - 1  # type: ignore[arg-type]
+    elif state["pending_nudge"]:
+        state["nudge_remaining"] = _JN_NUDGE_WINDOW
+        state["pending_nudge"] = False
+    _jn_write_nudge_remaining(int(state["nudge_remaining"]))  # type: ignore[arg-type]
+
