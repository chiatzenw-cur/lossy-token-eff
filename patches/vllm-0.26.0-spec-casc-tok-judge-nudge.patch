+# Shared with gpu_model_runner.py's own half: the count of NUDGE rounds
+# still remaining. WRITTEN here (this is the only place that knows the
+# judge's own score, and therefore the only place mode transitions can
+# happen), read there to decide which pattern to force next round.
+_JN_NUDGE_REMAINING_FILE = f"/tmp/lossy-token-eff-judge-nudge-remaining-{os.getuid()}"
