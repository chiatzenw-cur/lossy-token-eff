+_JN_STATE: dict[str, object] = {"committed_before": 0, "nudge_remaining": 0, "pending_nudge": False}
+_JN_WARMUP_BATCH_THRESHOLD = 8
+
+
+def _jn_apply(
+    target_logits: torch.Tensor,
+    target_probs: torch.Tensor,
+    draft_token_ids: torch.Tensor,
+    num_draft_tokens: list[int],
+    cu_num_draft_tokens: torch.Tensor,
+) -> torch.Tensor:
+    """Returns possibly-modified target_probs (a NEW tensor when either
+    mode fires, the ORIGINAL tensor unchanged otherwise). NUDGE mode
+    (nudge_remaining > 0): blends z0/z_reflect at the real positions,
+    bans the RV prompt's own first token. JUDGE mode (default): reads
+    p_true/p_false at the judgment row, bans the judge criterion's own
+    first token, and -- if score crosses threshold -- ARMS a pending
+    nudge (never itself transitions mode; see _jn_update)."""
+    state = _JN_STATE
+    if _JN_REAL_DRAFT_LEN <= 0 or not num_draft_tokens or num_draft_tokens[0] == 0:
+        return target_probs
+    n0 = num_draft_tokens[0]
+    if n0 < _JN_REAL_DRAFT_LEN:
+        return target_probs
+    end0 = int(cu_num_draft_tokens[0].item())
+    start0 = end0 - n0
+
+    if state["nudge_remaining"]:  # type: ignore[truthy-bool]
+        total_needed = 2 * _JN_REAL_DRAFT_LEN + _JN_RV_PROMPT_LEN
+        if n0 < total_needed:
+            return target_probs
+        prompt_start_row = start0 + _JN_REAL_DRAFT_LEN
+        dup_start_row = prompt_start_row + _JN_RV_PROMPT_LEN
+
+        z0 = target_logits[start0:start0 + _JN_REAL_DRAFT_LEN]
+        z_reflect = target_logits[dup_start_row:dup_start_row + _JN_REAL_DRAFT_LEN]
+        z_mix = (1.0 - _JN_RV_ALPHA) * z0 + _JN_RV_ALPHA * z_reflect
+        p_mix = z_mix.softmax(dim=-1, dtype=torch.float32)
+
+        new_probs = target_probs.clone()
+        new_probs[start0:start0 + _JN_REAL_DRAFT_LEN] = p_mix
+
+        banned_tok = int(draft_token_ids[prompt_start_row].item())
+        new_probs[prompt_start_row, banned_tok] = 0.0
+        row_sum = new_probs[prompt_start_row].sum().clamp_min(1e-30)
+        new_probs[prompt_start_row] = new_probs[prompt_start_row] / row_sum
+
+        _jn_write_trace({
+            "mode": "nudge",
+            "committed_before_this_round": _JN_STATE["committed_before"],
+            "nudge_remaining_before_this_round": state["nudge_remaining"],
+            "rv_alpha": _JN_RV_ALPHA,
+        })
+        return new_probs
+
+    # JUDGE mode.
+    total_needed = _JN_REAL_DRAFT_LEN + _JN_JUDGE_LEN
+    if n0 < total_needed:
+        return target_probs
+    judgment_row = start0 + total_needed - 1
+    criterion_start_row = start0 + _JN_REAL_DRAFT_LEN
+
+    p_true = sum(target_probs[judgment_row, t].item() for t in _JN_TRUE_IDS)
+    p_false = sum(target_probs[judgment_row, t].item() for t in _JN_FALSE_IDS)
+    score = p_true - p_false
+    if score > _JN_JUDGE_THRESHOLD:
+        state["pending_nudge"] = True
+
+    topk_probs, topk_ids = torch.topk(target_probs[judgment_row], k=min(15, target_probs.shape[-1]))
+    _jn_write_trace({
+        "mode": "judge",
+        "committed_before_this_round": _JN_STATE["committed_before"],
+        "p_true": p_true,
+        "p_false": p_false,
+        "score": score,
+        "threshold": _JN_JUDGE_THRESHOLD,
+        "pending_nudge": bool(state["pending_nudge"]),
+        "top_ids": topk_ids.tolist(),
+        "top_probs": [round(p, 6) for p in topk_probs.tolist()],
+    })
+
+    banned = target_probs.clone()
+    banned_tok = int(draft_token_ids[criterion_start_row].item())
+    banned[criterion_start_row, banned_tok] = 0.0
+    row_sum = banned[criterion_start_row].sum().clamp_min(1e-30)
+    banned[criterion_start_row] = banned[criterion_start_row] / row_sum
+    return banned
+
