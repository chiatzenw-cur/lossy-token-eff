+# Mechanism: a per-token id set (see below) triggers a K-token "strict
+# window" the moment one is ACCEPTED by tok's own test (whichever rule
+# accepted it -- normal spec-casc-tok, or an already-active window). Inside
+# an active window, the accept/reject test uses the raw lossless ratio
+# p(x)/q(x) >= u instead of spec-casc-tok's own pi_rej -- i.e. genuinely
+# strict, not spec-casc-tok's blend -- for K CONSECUTIVE VERIFIED positions
+# (positions that go through the accept/reject test; a bonus token, which
+# never does, doesn't consume the window and isn't itself gated). Recovery
+# on a rejection inside the window still samples from spec-casc-tok's own
+# pi_rej-based residual, unchanged -- a deliberate simplification: unlike
+# the other two guards, WHICH positions fall inside a window can only be
+# known by walking the round sequentially (a marker accepted mid-round
+# arms the window for the REST of that round), so there is no way to
+# precompute an "effective recovery target" tensor in Python before the
+# kernel runs, the way the other two guards do. Making recovery consistent
+# with the accept test here would need a second kernel pass or an
+# in-kernel resample; out of scope for this experiment.
+#
+# STATE IS PERSISTENT ACROSS ROUNDS, a first for this repo's patches (every
+# other guard/method here is stateless -- computed fresh from the current
+# round's tensors alone). The remaining-window count carries from the end
+# of one round to the start of the next via a small per-batch-slot tensor,
+# read back into a plain Python dict after each kernel launch. This is only
+# correct for EXACTLY the discipline this repo already runs under -- one
+# real sequence per server process (see remote/ENVIRONMENT.md's "Fresh
+# server per measurement" section) -- so only batch slot 0 is tracked
+# in the persistent dict; other slots (which only exist during vLLM's own
+# warmup/CUDA-graph-capture passes with large synthetic batches, never
+# during real generation in this repo's protocol) are read but discarded.
+# A large-batch (warmup-shaped) round explicitly resets slot 0's persisted
+# state to 0 before use, so a real generation's first token is never
+# started with leftover window state from an unrelated warmup pass.
+_SPEC_CASC_TOK_GUARD_FUTURE_ALPHA_FILE = f"/tmp/lossy-token-eff-spec-casc-tok-semantic-guard-future-guard-alpha-{os.getuid()}"
+try:
+    with open(_SPEC_CASC_TOK_GUARD_FUTURE_ALPHA_FILE) as _f:
+        _SPEC_CASC_TOK_ALPHA = float(_f.read().strip())
+    _SPEC_CASC_TOK_ALPHA_SOURCE = _SPEC_CASC_TOK_GUARD_FUTURE_ALPHA_FILE
+except (OSError, ValueError):
+    _SPEC_CASC_TOK_ALPHA = float("-inf")
+    _SPEC_CASC_TOK_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_TOK_GUARD_FUTURE_ALPHA_FILE}"
+
+# K, the future-guard window length -- own file (int, not a probability), same
+# uid+repo-scoped /tmp convention as every alpha file in this repo. Default
+# 8: matches the k=8 trailing-window size already used elsewhere in this
+# investigation's hidden-state recurrence work (analysis/semantic_guard/
+# find_hidden_state_recurrence_onsets.py), picked there for the same
+# "how far downstream is worth looking" reasoning, not independently
+# re-derived here.
+_SPEC_CASC_TOK_GUARD_FUTURE_K_FILE = f"/tmp/lossy-token-eff-spec-casc-tok-semantic-guard-future-guard-k-{os.getuid()}"
+try:
+    with open(_SPEC_CASC_TOK_GUARD_FUTURE_K_FILE) as _f:
+        _SPEC_CASC_TOK_GUARD_FUTURE_K = int(_f.read().strip())
+except (OSError, ValueError):
+    _SPEC_CASC_TOK_GUARD_FUTURE_K = 8
+
+# Wider marker/discourse-connective set -- identical to
+# r_fuzzy_semantic_guard_v2's own list (see that patch's module comment for
+# the full derivation and the explicit caveat: most of these additions,
+# beyond the original 5, are generic discourse connectives that open
+# ordinary correct reasoning steps just as often as corrupted ones, not
+# hesitation markers specifically). Reused verbatim rather than re-derived,
+# per this experiment's own instruction to widen the marker set -- see
+# analysis/semantic_guard/README.md.
+_SEMANTIC_GUARD_TOKEN_IDS: tuple[int, ...] = (
+    29126, 17114, 5238, 24305,       # wait
+    112576, 186402, 165972,          # hmm
+    138925, 87471, 4771, 50557,      # actually
+    8293, 7943, 889, 3072,           # but
+    58369, 35717, 41021,             # let's
+    84787, 23586,                    # thus
+    2167, 1416,                      # we
+    5808, 2632,                      # so
+    10620, 6549,                     # now
+    12845,                           # let (sentence-initial only)
+    56734, 45438,                    # compute
+    151907, 65037,                   # similarly
+    55292, 38966,                    # define
+    3879, 7217,                      # from
+)
+_semantic_guard_id_tensor_cache: dict[torch.device, torch.Tensor] = {}
+# Persistent per-round-carryover state -- batch slot 0 only, see the
+# module-level comment above for why that's the correct scope here.
+_FUTURE_GUARD_STATE: dict[str, int] = {"remaining": 0}
+_FUTURE_GUARD_WARMUP_BATCH_THRESHOLD = 8  # matches relaxation_trace.py's own _MAX_REAL_BATCH
+
+
+def _semantic_guard_mask(draft_token_ids: torch.Tensor) -> torch.Tensor:
+    """[num_tokens] bool: True where the drafted token is one of the
+    hesitation/discourse-marker ids above. Independently inlined rather
+    than shared with the other two semantic-guard patches -- mutually
+    exclusive alternate states of the same source file under
+    patches/apply.sh's dispatcher."""
+    device = draft_token_ids.device
+    ids = _semantic_guard_id_tensor_cache.get(device)
+    if ids is None:
+        ids = torch.tensor(_SEMANTIC_GUARD_TOKEN_IDS, device=device, dtype=draft_token_ids.dtype)
+        _semantic_guard_id_tensor_cache[device] = ids
+    return torch.isin(draft_token_ids, ids)
+
+
+print(
+    f"[SPEC-CASC-TOK-SEMANTIC-GUARD-FUTURE-GUARD PATCH] pid={os.getpid()} alpha={_SPEC_CASC_TOK_ALPHA} "
+    f"({_SPEC_CASC_TOK_ALPHA_SOURCE}) k={_SPEC_CASC_TOK_GUARD_FUTURE_K} "
+    f"guard_token_ids={len(_SEMANTIC_GUARD_TOKEN_IDS)}",
+    file=sys.stderr,
+    flush=True,
+)
