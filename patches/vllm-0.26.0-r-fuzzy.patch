     # Rejection sampling for random sampling requests.
     assert uniform_probs is not None
+
+    # r-fuzzy defer decision, computed once here in plain PyTorch (same
+    # pre-reduction-before-kernel-launch style as this repo's spec-casc-opt
+    # patch) rather than as a new full-vocab Triton reduction. None when
+    # draft_probs is unavailable (NO_DRAFT_PROBS): there is no q to compare
+    # against p, so the kernel keeps its original always-strict behaviour.
+    defer_mask: torch.Tensor | None = None
+    if draft_probs is not None:
+        _eps = 1e-12
+        m = 0.5 * (target_probs + draft_probs)
+        log_m = torch.log(m.clamp_min(_eps))
+        kl_pm = (target_probs * (torch.log(target_probs.clamp_min(_eps)) - log_m)).sum(dim=-1)
+        kl_qm = (draft_probs * (torch.log(draft_probs.clamp_min(_eps)) - log_m)).sum(dim=-1)
+        jsd = (0.5 * kl_pm + 0.5 * kl_qm).clamp_min(0.0)
+        # Div(p,q) < alpha means "trust q completely" (pi_rej == q, always
+        # accept); everything else defers to the strict p/q test. alpha=-inf
+        # makes this branch always defer, i.e. exactly strict spec-dec.
+        defer_mask = (jsd >= _R_FUZZY_ALPHA).contiguous()
