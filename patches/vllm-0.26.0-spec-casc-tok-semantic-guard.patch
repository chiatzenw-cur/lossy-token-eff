+    # NOT 0.0 -- see the module comment above. -inf empties the trusted top
+    # set entirely, which is the actual strict point for this method.
+    _SPEC_CASC_TOK_ALPHA = float("-inf")
+    _SPEC_CASC_TOK_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_TOK_ALPHA_FILE}"
+
+# SEMANTIC GUARD (analysis/semantic_guard/, not upstream vLLM, not part of
+# Xia et al.'s taxonomy -- a variant ON TOP of spec-casc-tok, not a new
+# relaxation method). Same hypothesis and same token-id list as this repo's
+# r_fuzzy_semantic_guard (see that patch's own module comment for the full
+# rationale and analysis/semantic_guard/README.md for the offline evidence):
+# force strict verification at hesitation/self-correction marker tokens,
+# leaving every other position's decision untouched.
+#
+# spec-casc-tok has no defer_mask to OR into -- unlike r-fuzzy/spec-casc-opt,
+# it's a genuine full-vocab BLEND (see the module comment above), not a
+# wholesale switch, so "force strict" here means forcing the trusted top set
+# A EMPTY for guarded rows: A={} => eta=1-0=1 => pi_rej(v)=1*p(v)=p(v) for
+# all v, which is EXACTLY this method's own alpha=-inf strict limit (see the
+# module comment above for that derivation) -- so forcing A empty at a
+# guarded row is provably identical to running alpha=-inf at that row alone,
+# not an approximation of strict.
+#
+# This has to be enforced in TWO places that must stay consistent with each
+# other: the full-vocab in_top_set computed in plain PyTorch below (used to
+# build eta and the full pi_rej tensor for recovery), and the kernel's own
+# from-scratch re-check of x_in_top_set for the drafted token alone (used
+# for the accept test) -- the kernel doesn't get the full in_top_set row,
+# only eta/top1 (already guard-aware once in_top_set is guard-aware) plus
+# top1 and alpha, from which it recomputes x's own membership independently
+# for efficiency (see spec-casc-tok's own module comment). Passing the same
+# guard_mask to both call sites (Python's in_top_set AND the kernel launch,
+# as a new pointer argument) is what keeps them from silently disagreeing at
+# guarded rows -- eta correct (says "empty set") but the kernel still
+# computing x_in_top_set from raw alpha/top1/target_prob, unaware of the
+# guard, would give a token whose OWN probability is very high (hesitation
+# markers often are: "wait", "but" etc. are common, high-p(x) continuations)
+# a real chance of x_in_top_set=True regardless of the guard.
+_SEMANTIC_GUARD_TOKEN_IDS: tuple[int, ...] = (
+    29126, 17114, 5238, 24305,
+    112576, 186402, 165972,
+    138925, 87471, 4771, 50557,
+    8293, 7943, 889, 3072,
+    58369, 35717, 41021,
+)
+_semantic_guard_id_tensor_cache: dict[torch.device, torch.Tensor] = {}
+
+
+def _semantic_guard_mask(draft_token_ids: torch.Tensor) -> torch.Tensor:
+    """[num_tokens] bool: True where the drafted token is one of the
+    hesitation-marker ids above -- identical to r_fuzzy_semantic_guard's own
+    helper of the same name (deliberately kept as a verbatim, small,
+    independently-inlined copy rather than a shared import: these two
+    patches are mutually-exclusive alternate states of the same source file
+    under patches/apply.sh's dispatcher, never imported from each other)."""
+    device = draft_token_ids.device
+    ids = _semantic_guard_id_tensor_cache.get(device)
+    if ids is None:
+        ids = torch.tensor(_SEMANTIC_GUARD_TOKEN_IDS, device=device, dtype=draft_token_ids.dtype)
+        _semantic_guard_id_tensor_cache[device] = ids
+    return torch.isin(draft_token_ids, ids)
+
+
+print(
+    f"[SPEC-CASC-TOK-SEMANTIC-GUARD PATCH] pid={os.getpid()} alpha={_SPEC_CASC_TOK_ALPHA} "
+    f"({_SPEC_CASC_TOK_ALPHA_SOURCE}) guard_token_ids={len(_SEMANTIC_GUARD_TOKEN_IDS)}",
+    file=sys.stderr,
