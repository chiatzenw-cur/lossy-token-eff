 import torch
 import torch.nn as nn
 
+# LOSSY-VERIFICATION PILOT PATCH (not upstream vLLM).
+#
+# Speculative Cascades with the CONFIDENCE-DIFFERENCE deferral rule
+# (spec-casc-diff), Narasimhan et al. 2025 Eq. 5 -- the baseline their OPT
+# rule (this repo's spec-casc-opt) was measured against:
+#
+#   defer  iff  max_u q(u) < max_u p(u) - alpha
+#   accept iff  defer and p(x)/q(x) >= u,  OR  not defer (always)
+#
+# Identical to spec-casc-opt except that the deferral margin is a constant
+# alpha instead of alpha * TV(p, q). alpha is any real; alpha -> -inf
+# recovers strict spec-dec exactly (max p + inf makes every position defer);
+# more negative defers more often. Because TV <= 1, spec-casc-diff at a
+# negative alpha is STRICTER than spec-casc-opt at the same alpha, and at a
+# positive alpha it is looser -- compare the two at matched mean accepted
+# length, never at equal alpha. Only the accept test changes; residual
+# sampling is stock p. Kernel hunk byte-identical to spec-casc-opt's.
+#
+# The alpha value comes from a file, not the environment: vLLM spawns
+# EngineCore with a sanitised environment, so env vars never reach the
+# sampler (see the other patches' identical note). The path is uid-scoped
+# under /tmp so a clone in any directory agrees with the server script.
+_SPEC_CASC_DIFF_ALPHA_FILE = f"/tmp/lossy-token-eff-spec-casc-diff-alpha-{os.getuid()}"
+try:
+    with open(_SPEC_CASC_DIFF_ALPHA_FILE) as _f:
+        _SPEC_CASC_DIFF_ALPHA = float(_f.read().strip())
+    _SPEC_CASC_DIFF_ALPHA_SOURCE = _SPEC_CASC_DIFF_ALPHA_FILE
+except (OSError, ValueError):
+    _SPEC_CASC_DIFF_ALPHA = float("-inf")  # always defer -> exactly strict spec-dec
+    _SPEC_CASC_DIFF_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_DIFF_ALPHA_FILE}"
+print(
+    f"[SPEC-CASC-DIFF PATCH] pid={os.getpid()} alpha={_SPEC_CASC_DIFF_ALPHA} "
+    f"({_SPEC_CASC_DIFF_ALPHA_SOURCE})",
+    file=sys.stderr,
+    flush=True,
+)
+
