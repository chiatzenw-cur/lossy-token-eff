+# Fixed token-id sequences, tokenized once via openai_harmony's
+# HARMONY_GPT_OSS (o200k_harmony) encoding and pinned as literal constants
+# (same "looked up once, stable across runs" convention as
+# find_macro_loop_restarts.py's special-token ids), round-trip verified
+# (enc.decode(ids) == the source text) at the time these were generated:
+#   question: "\n\nWait, let me pause and check: am I going in circles
+#              here, making no real progress? Answer yes or no:"
+#   pivot:    "\n\nYes -- I am going in circles. Let me abandon this
+#              approach and restart with a cleaner, more direct method.\n\n"
+_SELF_CHECK_QUESTION_PATTERN = [
+    279, 17114, 11, 1632, 668, 30748, 326, 2371, 25, 939, 357, 2966, 306,
+    45131, 2105, 11, 4137, 860, 1374, 7408, 30, 30985, 14531, 503, 860, 25,
+]
+_SELF_CHECK_PIVOT_PATTERN = [
+    279, 13022, 2230, 357, 939, 2966, 306, 45131, 13, 9024, 668, 23067, 495,
+    7139, 326, 33437, 483, 261, 43956, 11, 945, 2823, 2595, 364,
+]
+# Same fixed boundary as spec-casc-tok-force-commit: <|end|>=200007
+# <|start|>=200006 "assistant"=173781 <|channel|>=200005 "final"=17196
+# <|message|>=200008.
+_SELF_CHECK_FINAL_OPEN_PATTERN = [200007, 200006, 173781, 200005, 17196, 200008]
+
+_SELF_CHECK_MODE_PATTERNS = {
+    "asking": _SELF_CHECK_QUESTION_PATTERN,
+    "pivoting": _SELF_CHECK_PIVOT_PATTERN,
+    "final_forcing": _SELF_CHECK_FINAL_OPEN_PATTERN,
+}
+_SELF_CHECK_ANSWER_MAX_TOKENS = 6
+_SELF_CHECK_TAIL_MAXLEN = 64
+_SELF_CHECK_WARMUP_BATCH_THRESHOLD = 8  # matches this repo's other cross-round-state patches
+
+_SELF_CHECK_STATE: dict[str, object] = {
+    "token_count": 0,
+    "next_check_at": _SELF_CHECK_INTERVAL,
+    "mode": "idle",  # idle | asking | reading | pivoting | final_forcing
+    "tail": [],
+    "answer_buffer": [],
+    "final_opened": False,
+}
+
+_SELF_CHECK_ENCODING = None
+
+
+def _self_check_get_encoding():
+    global _SELF_CHECK_ENCODING
+    if _SELF_CHECK_ENCODING is None:
+        from openai_harmony import HarmonyEncodingName, load_harmony_encoding
+
+        _SELF_CHECK_ENCODING = load_harmony_encoding(HarmonyEncodingName.HARMONY_GPT_OSS)
+    return _SELF_CHECK_ENCODING
+
+
+def _self_check_decode(ids: list[int]) -> str:
+    """Best-effort decode of a short token id list to text -- tolerant of a
+    trailing incomplete multi-byte sequence (returns whatever prefix
+    decodes cleanly, dropping an unresolved tail, rather than raising).
+    Only used for a coarse "does this start with yes/no" check, so a
+    slightly short decode on the rare split-character case is harmless."""
+    enc = _self_check_get_encoding()
+    for cut in range(len(ids), 0, -1):
+        try:
+            return enc.decode_utf8(ids[:cut])
+        except Exception:
+            continue
+    return ""
+
+
+def _self_check_read_answer(ids: list[int]) -> bool | None:
+    """True/False once the buffered tokens' decoded text clearly starts
+    (after stripping whitespace/quoting) with "yes" or "no"; None while
+    still ambiguous -- caller keeps accumulating until
+    _SELF_CHECK_ANSWER_MAX_TOKENS, then treats None as "no" (the SAFE
+    default: an ambiguous or non-cooperating answer must never be read as
+    license to intervene)."""
+    text = _self_check_decode(ids).strip().lower().lstrip("*_\"'() \t\n")
+    if text.startswith("yes"):
+        return True
+    if text.startswith("no"):
+        return False
+    return None
+
+
+def _self_check_pattern_progress(tail: list[int], pattern: list[int]) -> int:
+    """Longest suffix of `tail` that equals a prefix of `pattern` -- same
+    logic as spec-casc-tok-force-commit's own pattern-progress check,
+    generalized to whichever fixed phrase is currently being forced."""
+    n = len(pattern)
+    for k in range(min(n, len(tail)), 0, -1):
+        if tail[-k:] == pattern[:k]:
+            return k
+    return 0
+
+
+def _self_check_apply(
+    target_probs: torch.Tensor,
+    num_draft_tokens: list[int],
+    cu_num_draft_tokens: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Pure read of persistent state -- never mutates _SELF_CHECK_STATE
+    (see the module-level comment for why). Returns (possibly-forced
+    target_probs, force_mask); force_mask is purely informational, same
+    convention as this repo's other guards.
+
+    Forces EVERY still-unforced pattern position available in this round,
+    not just the first (start0) -- a real bug caught by observing a live
+    run: if start0's forced token happens to be genuinely ACCEPTED (the
+    draft's own natural proposal coincides with it, plausible for common
+    short words, and especially likely right after the model has just been
+    forced to say the pattern's own opening words -- it tends to keep
+    talking in that voice), the round does NOT terminate the way a
+    force-REJECTION always does; it continues to this round's later
+    positions, which -- if only start0 were forced -- would fall through to
+    UNFORCED, fully natural target_probs, letting the model's own
+    continuation diverge from the intended pattern mid-force. The next
+    round's tail-based progress readback then (correctly) detects the
+    broken match and restarts the pattern from token 0, producing a real,
+    observed degenerate cycle (the pivot phrase's own opening words
+    repeating over and over, each time diverging at the same point and
+    restarting) -- the exact failure shape this patch exists to fix,
+    except self-inflicted by the forcing mechanism itself. Forcing the
+    round's full available span (min(this round's draft length, pattern
+    tokens remaining)) closes this: every position that could possibly be
+    reached while still mid-pattern is deterministically pinned, so an
+    accept-vs-reject-then-recover coin flip at any one position can never
+    let natural content leak into the middle of a forced phrase."""
+    state = _SELF_CHECK_STATE
+    num_tokens = target_probs.shape[0]
+    force_mask = torch.zeros(num_tokens, dtype=torch.bool, device=target_probs.device)
+    if state["final_opened"]:
+        return target_probs, force_mask
+    mode = state["mode"]
+    pattern = _SELF_CHECK_MODE_PATTERNS.get(mode)
+    if pattern is None:  # "idle" or "reading" -- nothing to force this round
+        return target_probs, force_mask
+    if not num_draft_tokens or num_draft_tokens[0] == 0:
+        return target_probs, force_mask
+    end0 = int(cu_num_draft_tokens[0].item())
+    n0 = num_draft_tokens[0]
+    start0 = end0 - n0
+    progress = _self_check_pattern_progress(state["tail"], pattern)  # type: ignore[arg-type]
+    remaining = len(pattern) - progress
+    if remaining <= 0:
+        return target_probs, force_mask
+    n_to_force = min(n0, remaining)
+    forced = target_probs.clone()
+    for i in range(n_to_force):
+        pos = start0 + i
+        forced_token = pattern[progress + i]
+        forced[pos] = 0.0
+        forced[pos, forced_token] = 1.0
+        force_mask[pos] = True
+    return forced, force_mask
+
+
+def _self_check_update(
+    output_token_ids: torch.Tensor,
+    num_draft_tokens: list[int],
+    batch_size: int,
+) -> None:
+    """Cross-round persistence AND the ONLY place _SELF_CHECK_STATE['mode']
+    ever changes -- every transition is gated on the ACTUAL emitted tokens
+    (ground truth), never an assumption about what _self_check_apply asked
+    the kernel to force. Same warmup-batch reset convention as this repo's
+    other cross-round-state patches."""
+    state = _SELF_CHECK_STATE
+    if batch_size > _SELF_CHECK_WARMUP_BATCH_THRESHOLD:
+        state["token_count"] = 0
+        state["next_check_at"] = _SELF_CHECK_INTERVAL
+        state["mode"] = "idle"
+        state["tail"] = []
+        state["answer_buffer"] = []
+        state["final_opened"] = False
+        return
+    row = output_token_ids[0].tolist()
+    emitted = [t for t in row if t != PLACEHOLDER_TOKEN_ID]
+    if not emitted:
+        return
+    state["token_count"] = int(state["token_count"]) + len(emitted)
+    if state["final_opened"]:
+        return
+
+    mode = state["mode"]
+    pattern = _SELF_CHECK_MODE_PATTERNS.get(mode)
+    if pattern is not None:
+        tail = list(state["tail"]) + emitted  # type: ignore[arg-type]
+        if len(tail) > _SELF_CHECK_TAIL_MAXLEN:
+            del tail[: len(tail) - _SELF_CHECK_TAIL_MAXLEN]
+        state["tail"] = tail
+        if _self_check_pattern_progress(tail, pattern) >= len(pattern):
+            if mode == "asking":
+                state["mode"] = "reading"
+                state["answer_buffer"] = []
+                state["tail"] = []
+            elif mode == "pivoting":
+                state["mode"] = "idle"
+                state["next_check_at"] = state["token_count"] + _SELF_CHECK_INTERVAL  # type: ignore[operator]
+                state["tail"] = []
+            elif mode == "final_forcing":
+                state["final_opened"] = True
+                state["tail"] = []
+        return
+
+    if mode == "reading":
+        buf = list(state["answer_buffer"]) + emitted  # type: ignore[arg-type]
+        decision = _self_check_read_answer(buf)
+        if decision is None and len(buf) < _SELF_CHECK_ANSWER_MAX_TOKENS:
+            state["answer_buffer"] = buf
+            return
+        messy = bool(decision)
+        state["answer_buffer"] = []
+        if messy and state["token_count"] < _SELF_CHECK_FINAL_THRESHOLD:  # type: ignore[operator]
+            state["mode"] = "pivoting"
+        elif messy:
+            state["mode"] = "final_forcing"
+        else:
+            state["mode"] = "idle"
+            state["next_check_at"] = state["token_count"] + _SELF_CHECK_INTERVAL  # type: ignore[operator]
+        return
+
+    # mode == "idle": has this sequence now burned enough tokens since the
+    # last check (or since the start) to schedule the next one?
+    if state["token_count"] >= state["next_check_at"]:  # type: ignore[operator]
+        state["mode"] = "asking"
+        state["tail"] = []
+
