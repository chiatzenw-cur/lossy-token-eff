+# Rather than a sixth cheap structural proxy, this patch outsources the
+# judgment call to the model itself. Every _SELF_CHECK_INTERVAL real
+# emitted tokens (persistent, cross-round token count), FORCE-inject a
+# short, fixed self-assessment question into the sequence's own stream --
+# one-hot target_probs, same mechanism as spec-casc-tok-force-commit and
+# spec-casc-tok-antiloop, so no kernel changes -- then let the next few
+# tokens generate COMPLETELY UNCONSTRAINED (no forcing at all) and read
+# back whether the model's own genuine answer starts with "yes" or "no".
+# An ambiguous or slow answer defaults to "no" (never treated as license to
+# intervene) after _SELF_CHECK_ANSWER_MAX_TOKENS. "No" costs only the
+# question+answer tax (~30 tokens) and resumes normal generation
+# unchanged. "Yes" force-injects a second fixed phrase -- a pivot
+# ("abandon this approach, restart cleaner") if there's still budget left,
+# or force-commit's own final-channel-open push if the budget is nearly
+# exhausted (reusing that patch's own default threshold and pattern, not
+# inventing a new one; the same fixed 6-token
+# `<|end|><|start|>assistant<|channel|>final<|message|>` boundary).
+#
+# Progress through whichever fixed phrase is currently being forced is
+# always read back from the sequence's OWN real emitted history (longest
+# tail-suffix matching a pattern prefix), never assumed -- same
+# self-correcting convention as force-commit. State mutation is confined
+# entirely to the post-round update function, gated on real
+# output_token_ids; the apply function is a pure read of persistent state,
+# never itself transitions a mode -- avoids a class of bugs where a mode
+# change taken on the strength of what we ASKED the kernel to force could
+# diverge from what the kernel actually emitted (accept/recovery still
+# involve real randomness even under a one-hot target).
+_SPEC_CASC_TOK_SELF_CHECK_ALPHA_FILE = f"/tmp/lossy-token-eff-spec-casc-tok-self-check-alpha-{os.getuid()}"
+try:
+    with open(_SPEC_CASC_TOK_SELF_CHECK_ALPHA_FILE) as _f:
+        _SPEC_CASC_TOK_ALPHA = float(_f.read().strip())
+    _SPEC_CASC_TOK_ALPHA_SOURCE = _SPEC_CASC_TOK_SELF_CHECK_ALPHA_FILE
+except (OSError, ValueError):
+    _SPEC_CASC_TOK_ALPHA = float("-inf")
+    _SPEC_CASC_TOK_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_TOK_SELF_CHECK_ALPHA_FILE}"
+print(
+    f"[SPEC-CASC-TOK-SELF-CHECK PATCH] pid={os.getpid()} alpha={_SPEC_CASC_TOK_ALPHA} "
+    f"({_SPEC_CASC_TOK_ALPHA_SOURCE})",
+    file=sys.stderr,
+    flush=True,
+)
+
+_SELF_CHECK_INTERVAL_FILE = f"/tmp/lossy-token-eff-spec-casc-tok-self-check-interval-{os.getuid()}"
+try:
+    with open(_SELF_CHECK_INTERVAL_FILE) as _f:
+        _SELF_CHECK_INTERVAL = int(float(_f.read().strip()))
+except (OSError, ValueError):
+    _SELF_CHECK_INTERVAL = 3000
+print(f"[SPEC-CASC-TOK-SELF-CHECK PATCH] pid={os.getpid()} interval={_SELF_CHECK_INTERVAL}", file=sys.stderr, flush=True)
+
+# Matches spec-casc-tok-force-commit's own default threshold -- deliberately
+# not re-derived independently; "nearly exhausted" should mean the same
+# thing to both patches.
+_SELF_CHECK_FINAL_THRESHOLD_FILE = f"/tmp/lossy-token-eff-spec-casc-tok-self-check-final-threshold-{os.getuid()}"
+try:
+    with open(_SELF_CHECK_FINAL_THRESHOLD_FILE) as _f:
+        _SELF_CHECK_FINAL_THRESHOLD = int(float(_f.read().strip()))
+except (OSError, ValueError):
+    _SELF_CHECK_FINAL_THRESHOLD = 28000
+print(
+    f"[SPEC-CASC-TOK-SELF-CHECK PATCH] pid={os.getpid()} final_threshold={_SELF_CHECK_FINAL_THRESHOLD}",
+    file=sys.stderr,
+    flush=True,
+)
