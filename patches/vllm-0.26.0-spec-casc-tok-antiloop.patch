+# ANTI-LOOP (analysis/semantic_guard/, not upstream vLLM, not part of Xia et
+# al.'s taxonomy). Reactive repetition breaker, built after this
+# investigation established three things empirically: (1) degenerate
+# repetition loops in this model are TARGET-MODEL-driven, not a relaxation
+# artifact -- a counterfactual splice showed PURE STRICT decoding falls into
+# the identical loop from the identical context; (2) once a loop is
+# established, target's own top-1 confidence in the repeated token climbs to
+# >99% within a handful of repeats, so no accept-test threshold (strict or
+# relaxed) can prevent continuing it -- there is no "wrong accept" to be
+# stricter about; (3) predicting a loop's onset IN ADVANCE from distributional
+# shape (entropy ramps, confidence dips) fails rigorous validation -- both
+# tested detectors perform WORSE than a random baseline at the same firing
+# rate, when checked against a periodic-repetition ground truth across real
+# traces. Point (1)+(2) rule out every "force strict" guard design already in
+# this repo for this failure mode; point (3) rules out prediction. What's
+# left, and what this patch does: don't predict, don't gate on token
+# identity or accept-test strictness -- REACT the moment a real repeat is
+# confirmed, by removing the SPECIFIC repeating token from the target
+# distribution before spec-casc-tok's own math runs, forcing a genuine
+# resample from what's left via the SAME recovery machinery spec-casc-tok
+# already has. Not a stricter threshold; a distribution edit.
+#
+# Detection: periodic repeat, period k in [1, ANTILOOP_MAX_PERIOD], banning
+# the token that would complete the ANTILOOP_MIN_REPEATS'th consecutive
+# occurrence of that period -- same definition this investigation validated
+# as ground truth (rare: ~0.01% of tokens even at this bar, across real
+# AIME24 traces), not a new untested threshold invented for this patch.
+# Checked against a PERSISTENT, CROSS-ROUND history buffer of the last
+# ANTILOOP_HISTORY_MAXLEN real emitted token ids (same single-real-sequence-
+# per-process scoping as this repo's future-guard patches -- see
+# spec-casc-tok-semantic-guard-future-guard's own module comment for the
+# full justification), extended OPTIMISTICALLY with this round's own drafted
+# continuation (assume-all-accepted) for positions later in the SAME round --
+# safe because a round that actually rejects earlier than a flagged position
+# terminates there (the standard "stop at first rejection" behavior every
+# method in this repo already has), so a flagged-but-never-reached position
+# never matters, and the ban is checked again fresh next round regardless.
+#
+# Mechanism, once a (position, token) pair is flagged: zero target_probs at
+# that exact (row, token) entry and renormalize the row, BEFORE spec-casc-
+# tok's own eta/pi_rej computation runs. Nothing downstream needs to know
+# about the ban specially -- eta/pi_rej/the accept-test kernel/recovery are
+# ALL already pure functions of target_probs, so a banned token: (a)
+# automatically falls out of the trusted top set (its p is now 0, below any
+# real threshold), (b) gets pi_rej(banned)=eta*0=0, so the accept test
+# rejects it regardless of alpha or u, and (c) gets zero residual mass in
+# recovery too, since recovery samples from pi_rej-q clamped, which is also
+# 0 there. Zero kernel/Triton changes needed -- this is pure Python/PyTorch
+# preprocessing on top of the UNMODIFIED base spec-casc-tok kernel.
+# strict_would_accept/lossy_would_accept passed to the tracer use the
+# ORIGINAL (pre-ban) target_probs, same "reflect the base method's own
+# unguarded decision" convention this repo's other guard patches follow --
+# antiloop_mask is passed as a separate, purely-informational field instead.
+_ANTILOOP_MAX_PERIOD = 12
+_ANTILOOP_MIN_REPEATS = 3
+_ANTILOOP_HISTORY_MAXLEN = 64  # >= MAX_PERIOD * MIN_REPEATS with margin
+_ANTILOOP_HISTORY: dict[str, list[int]] = {"tokens": []}
+_ANTILOOP_WARMUP_BATCH_THRESHOLD = 8  # matches relaxation_trace.py's own _MAX_REAL_BATCH
+
+
+def _antiloop_completes_repeat(seq: list[int]) -> bool:
+    """True iff seq's own tail is the same period-k block (k in
+    [1, _ANTILOOP_MAX_PERIOD]) repeated _ANTILOOP_MIN_REPEATS times
+    consecutively -- i.e. appending seq[-1] just completed that Nth repeat.
+    Smallest k checked first and returned on first hit (a real period-1
+    repeat trivially also "matches" as period-2, period-3, etc. against a
+    longer tail; checking smallest-first reports the tightest true period)."""
+    n = len(seq)
+    for k in range(1, _ANTILOOP_MAX_PERIOD + 1):
+        span = _ANTILOOP_MIN_REPEATS * k
+        if n < span:
+            continue
+        tail = seq[n - span:]
+        block0 = tail[:k]
+        if all(tail[i * k:(i + 1) * k] == block0 for i in range(1, _ANTILOOP_MIN_REPEATS)):
+            return True
+    return False
+
+
+def _antiloop_apply_ban(
+    target_probs: torch.Tensor,
+    draft_token_ids: torch.Tensor,
+    num_draft_tokens: list[int],
+    cu_num_draft_tokens: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Returns (banned_target_probs, antiloop_mask). banned_target_probs is
+    a NEW tensor (never mutates the caller's target_probs in place -- the
+    original is what gets passed to the tracer, see the module comment) with
+    any flagged (position, drafted-token) entry zeroed and that row
+    renormalized. antiloop_mask is [num_tokens] bool, True at flagged
+    positions, purely informational (same convention as this repo's other
+    guards' token_marker_guard_mask)."""
+    history = _ANTILOOP_HISTORY["tokens"]
+    draft_ids_cpu = draft_token_ids.tolist()
+    cu_cpu = cu_num_draft_tokens.tolist()
+    num_tokens = draft_token_ids.numel()
+    antiloop_mask = torch.zeros(num_tokens, dtype=torch.bool, device=target_probs.device)
+    banned_rows: list[int] = []
+    banned_cols: list[int] = []
+    for b, n in enumerate(num_draft_tokens):
+        end = cu_cpu[b]
+        start = end - n
+        # Only slot 0 carries real persistent history -- see the module
+        # comment for the single-real-sequence-per-process scoping this
+        # relies on. Other slots (warmup/CUDA-graph-capture only) never get
+        # a ban applied, matching this repo's future-guard patches' own
+        # slot-0-only convention.
+        if b != 0:
+            continue
+        seq = list(history)
+        for j in range(n):
+            tok = draft_ids_cpu[start + j]
+            seq.append(tok)
+            if _antiloop_completes_repeat(seq):
+                antiloop_mask[start + j] = True
+                banned_rows.append(start + j)
+                banned_cols.append(tok)
+    if not banned_rows:
+        return target_probs, antiloop_mask
+    banned = target_probs.clone()
+    rows_t = torch.tensor(banned_rows, device=target_probs.device, dtype=torch.long)
+    cols_t = torch.tensor(banned_cols, device=target_probs.device, dtype=torch.long)
+    banned[rows_t, cols_t] = 0.0
+    row_sums = banned[rows_t].sum(dim=-1, keepdim=True).clamp_min(1e-30)
+    banned[rows_t] = banned[rows_t] / row_sums
+    return banned, antiloop_mask
+
+
+def _antiloop_update_history(
+    output_token_ids: torch.Tensor,
+    num_draft_tokens: list[int],
+    batch_size: int,
+) -> None:
+    """Cross-round persistence: append whatever ACTUALLY got emitted this
+    round (from the finalized output_token_ids, including any bonus token --
+    ground truth, not the round's own optimistic draft assumption used for
+    same-round detection above) to the history buffer, trimmed to the last
+    _ANTILOOP_HISTORY_MAXLEN tokens. A batch this large can only be one of
+    vLLM's own warmup/CUDA-graph-capture passes (never real generation here,
+    same threshold this repo's future-guard patches use), so history is
+    cleared instead of extended, keeping a warmup pass from leaking stale
+    tokens into the start of real generation."""
+    if batch_size > _ANTILOOP_WARMUP_BATCH_THRESHOLD:
+        _ANTILOOP_HISTORY["tokens"] = []
+        return
+    row = output_token_ids[0].tolist()
+    emitted = [t for t in row if t != PLACEHOLDER_TOKEN_ID]
+    history = _ANTILOOP_HISTORY["tokens"]
+    history.extend(emitted)
+    if len(history) > _ANTILOOP_HISTORY_MAXLEN:
+        del history[: len(history) - _ANTILOOP_HISTORY_MAXLEN]
+
