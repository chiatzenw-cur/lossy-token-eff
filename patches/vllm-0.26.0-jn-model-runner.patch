+# (the default); >0 = nudge mode, counting down.
+_JN_NUDGE_REMAINING_FILE = f"/tmp/lossy-token-eff-judge-nudge-remaining-{os.getuid()}"
+
+
+def _jn_read_nudge_remaining() -> int:
+    try:
+        with open(_JN_NUDGE_REMAINING_FILE) as f:
+            return int(float(f.read().strip()))
+    except (OSError, ValueError):
+        return 0
+
+
+def _jn_overwrite(draft_token_ids, draft_probs) -> None:
+    """In-place: overwrite row 0's own columns starting at
+    [REAL_DRAFT_LEN:) with either the judge criterion (default) or the
+    RV reflection-prompt + duplicate-draft pattern (nudge mode, while
+    rejection_sampler.py's own nudge_remaining counter is > 0) -- see the
+    module-level comment for the round layout and why an unused trailing
+    tail (when the chosen pattern is shorter than the configured max
+    width) is harmless. draft_probs at the overwritten positions is set
+    one-hot purely to stay a valid, non-NaN distribution -- these
+    positions are always force-rejected on the rejection_sampler.py side
+    regardless of what draft_probs says, same convention as every other
+    patch in this repo that overwrites drafted content."""
+    if _JN_REAL_DRAFT_LEN <= 0:
+        return
+    if not torch.is_tensor(draft_token_ids) or draft_token_ids.shape[0] == 0:
+        return
+    total_width = draft_token_ids.shape[1]
+    nudge_remaining = _jn_read_nudge_remaining()
+
+    if nudge_remaining > 0:
+        needed = 2 * _JN_REAL_DRAFT_LEN + _JN_RV_PROMPT_LEN
+        if total_width < needed:
+            return
+        prompt_start = _JN_REAL_DRAFT_LEN
+        dup_start = _JN_REAL_DRAFT_LEN + _JN_RV_PROMPT_LEN
+        pattern_t = torch.tensor(
+            _JN_RV_PROMPT_PATTERN, dtype=draft_token_ids.dtype, device=draft_token_ids.device
+        )
+        draft_token_ids[0, prompt_start:dup_start] = pattern_t
+        draft_token_ids[0, dup_start:dup_start + _JN_REAL_DRAFT_LEN] = draft_token_ids[0, 0:_JN_REAL_DRAFT_LEN]
+        if torch.is_tensor(draft_probs) and draft_probs.shape[0] > 0 and draft_probs.shape[1] >= total_width:
+            vocab = draft_probs.shape[-1]
+            draft_probs[0, prompt_start:dup_start, :] = 0.0
+            for i, tok in enumerate(_JN_RV_PROMPT_PATTERN):
+                if 0 <= tok < vocab:
+                    draft_probs[0, prompt_start + i, tok] = 1.0
+            draft_probs[0, dup_start:dup_start + _JN_REAL_DRAFT_LEN, :] = 0.0
+            for i in range(_JN_REAL_DRAFT_LEN):
+                tok = int(draft_token_ids[0, dup_start + i].item())
+                if 0 <= tok < vocab:
+                    draft_probs[0, dup_start + i, tok] = 1.0
+    else:
+        needed = _JN_REAL_DRAFT_LEN + _JN_JUDGE_LEN
+        if total_width < needed:
+            return
+        start = _JN_REAL_DRAFT_LEN
+        pattern_t = torch.tensor(
+            _JN_JUDGE_PATTERN, dtype=draft_token_ids.dtype, device=draft_token_ids.device
+        )
+        draft_token_ids[0, start:start + _JN_JUDGE_LEN] = pattern_t
+        if torch.is_tensor(draft_probs) and draft_probs.shape[0] > 0 and draft_probs.shape[1] >= total_width:
+            vocab = draft_probs.shape[-1]
+            draft_probs[0, start:start + _JN_JUDGE_LEN, :] = 0.0
+            for i, tok in enumerate(_JN_JUDGE_PATTERN):
+                if 0 <= tok < vocab:
+                    draft_probs[0, start + i, tok] = 1.0
+
