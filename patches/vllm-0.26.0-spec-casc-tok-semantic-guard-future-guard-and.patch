+# Persistent per-round-carryover state -- batch slot 0 only, see the
+# module-level comment above for why that's the correct scope here.
+_FUTURE_GUARD_STATE: dict[str, int] = {"remaining": 0}
+_FUTURE_GUARD_WARMUP_BATCH_THRESHOLD = 8  # matches relaxation_trace.py's own _MAX_REAL_BATCH
+
