+def _semantic_guard_mask(draft_token_ids: torch.Tensor) -> torch.Tensor:
+    """[num_tokens] bool: True where the drafted token is one of the
+    hesitation/discourse-marker ids above. Independently inlined rather
+    than shared with the other two semantic-guard patches -- mutually
+    exclusive alternate states of the same source file under
+    patches/apply.sh's dispatcher."""
+    device = draft_token_ids.device
+    ids = _semantic_guard_id_tensor_cache.get(device)
+    if ids is None:
+        ids = torch.tensor(_SEMANTIC_GUARD_TOKEN_IDS, device=device, dtype=draft_token_ids.dtype)
+        _semantic_guard_id_tensor_cache[device] = ids
+    return torch.isin(draft_token_ids, ids)
+
