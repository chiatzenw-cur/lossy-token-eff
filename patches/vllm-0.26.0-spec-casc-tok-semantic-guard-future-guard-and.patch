+    112576, 186402, 165972,          # hmm
+    138925, 87471, 4771, 50557,      # actually
+    8293, 7943, 889, 3072,           # but
+    58369, 35717, 41021,             # let's
+    84787, 23586,                    # thus
+    2167, 1416,                      # we
+    5808, 2632,                      # so
+    10620, 6549,                     # now
+    12845,                           # let (sentence-initial only)
+    56734, 45438,                    # compute
+    151907, 65037,                   # similarly
+    55292, 38966,                    # define
+    3879, 7217,                      # from
