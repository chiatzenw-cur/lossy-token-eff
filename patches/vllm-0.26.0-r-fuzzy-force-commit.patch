+_R_FUZZY_FINAL_OPEN_PATTERN = [200007, 200006, 173781, 200005, 17196, 200008]
+_R_FUZZY_FORCE_COMMIT_WARMUP_BATCH_THRESHOLD = 8
+_R_FUZZY_FORCE_COMMIT_HISTORY_MAXLEN = 64
+
+_R_FUZZY_FORCE_COMMIT_STATE: dict[str, object] = {
+    "token_count": 0,
+    "final_opened": False,
+    "tail": [],
+}
+
+
+def _r_fuzzy_force_commit_pattern_progress(tail: list[int]) -> int:
+    n = len(_R_FUZZY_FINAL_OPEN_PATTERN)
+    for k in range(min(n, len(tail)), 0, -1):
+        if tail[-k:] == _R_FUZZY_FINAL_OPEN_PATTERN[:k]:
+            return k
+    return 0
+
+
+def _r_fuzzy_force_commit_apply(target_probs, num_draft_tokens, cu_num_draft_tokens):
+    """Returns (possibly-forced target_probs, force_mask). Identical logic
+    to spec-casc-tok-force-commit's own _force_commit_apply -- see that
+    patch's docstring for the start0-only-forcing bug this already avoids
+    by forcing every still-unforced pattern position available each round."""
+    state = _R_FUZZY_FORCE_COMMIT_STATE
+    num_tokens = target_probs.shape[0]
+    force_mask = torch.zeros(num_tokens, dtype=torch.bool, device=target_probs.device)
+    if state["final_opened"] or state["token_count"] < _R_FUZZY_FORCE_COMMIT_THRESHOLD:
+        return target_probs, force_mask
+    if not num_draft_tokens or num_draft_tokens[0] == 0:
+        return target_probs, force_mask
+    end0 = int(cu_num_draft_tokens[0].item())
+    n0 = num_draft_tokens[0]
+    start0 = end0 - n0
+    progress = _r_fuzzy_force_commit_pattern_progress(state["tail"])
+    remaining = len(_R_FUZZY_FINAL_OPEN_PATTERN) - progress
+    if remaining <= 0:
+        return target_probs, force_mask
+    n_to_force = min(n0, remaining)
+    forced = target_probs.clone()
+    for i in range(n_to_force):
+        pos = start0 + i
+        forced_token = _R_FUZZY_FINAL_OPEN_PATTERN[progress + i]
+        forced[pos] = 0.0
+        forced[pos, forced_token] = 1.0
+        force_mask[pos] = True
+    return forced, force_mask
+
+
+def _r_fuzzy_force_commit_update(output_token_ids, num_draft_tokens, batch_size) -> None:
+    state = _R_FUZZY_FORCE_COMMIT_STATE
+    if batch_size > _R_FUZZY_FORCE_COMMIT_WARMUP_BATCH_THRESHOLD:
+        state["token_count"] = 0
+        state["final_opened"] = False
+        state["tail"] = []
+        return
+    row = output_token_ids[0].tolist()
+    emitted = [t for t in row if t != PLACEHOLDER_TOKEN_ID]
+    if not emitted:
+        return
+    state["token_count"] = int(state["token_count"]) + len(emitted)
+    if state["final_opened"]:
+        return
+    tail = list(state["tail"]) + emitted
+    if len(tail) > _R_FUZZY_FORCE_COMMIT_HISTORY_MAXLEN:
+        del tail[: len(tail) - _R_FUZZY_FORCE_COMMIT_HISTORY_MAXLEN]
+    state["tail"] = tail
+    if _r_fuzzy_force_commit_pattern_progress(tail) >= len(_R_FUZZY_FINAL_OPEN_PATTERN):
+        state["final_opened"] = True
+
