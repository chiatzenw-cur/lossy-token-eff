+    # NOT 0.0 -- see the module comment above. -inf empties the trusted top
+    # set entirely, which is the actual strict point for this method.
+    _SPEC_CASC_TOK_ALPHA = float("-inf")
+    _SPEC_CASC_TOK_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_TOK_ALPHA_FILE}"
+
+# AUTOGUARD (autoresearch/, not upstream vLLM, not part of Xia et al.'s
+# taxonomy -- a variant ON TOP of spec-casc-tok, not a new relaxation method).
+#
+# Structurally identical to spec-casc-tok-semantic-guard: for a per-position
+# boolean mask, force the trusted top set A EMPTY at masked rows, which is
+# provably identical to running this method's own alpha=-inf (strict) at
+# those rows alone (A={} => eta=1 => pi_rej(v)=p(v) for all v). The ONLY
+# difference is where the mask comes from: semantic-guard hard-codes a
+# hesitation-marker token-id list here; autoguard delegates the whole
+# decision to vllm/v1/sample/autoguard.py::decide(), a plain-Python,
+# round-granular function that the autoresearch loop is free to rewrite
+# (patches/autoguard.py is the ONLY file that loop edits -- everything in
+# THIS file, the kernel included, is frozen). decide() returns a
+# [num_tokens] bool: True => force strict verification at that position.
+#
+# The mask is enforced in the same TWO consistent places semantic-guard uses
+# (the full-vocab in_top_set built in plain PyTorch below, and the kernel's
+# own from-scratch x_in_top_set recheck via semantic_guard_mask_ptr) -- see
+# spec-casc-tok-semantic-guard's own module comment for why both are needed.
+#
+# State (round index + a rolling committed-token history) is module-level,
+# correct without per-request keying only because this repo's protocol
+# serves exactly one request per fresh server -- same scoping convention as
+# spec-casc-tok-hsr-guard and r-fuzzy-window-entropy-guard. The history is
+# updated AFTER the kernel each round (_autoguard_observe, called from the
+# main function just before the tracer hook), never before -- the mask for
+# round N is computed from rounds < N only.
+from vllm.v1.sample import autoguard as _autoguard
+
+_AUTOGUARD_HISTORY: list[int] = []          # committed token ids, request 0, oldest-first
+_AUTOGUARD_HISTORY_CAP = 40000              # plenty for AIME-length runs; bounds worst-case memory
+_AUTOGUARD_STATE = {"round_index": 0}
+_autoguard_warned = False
+
+
+def _autoguard_mask(
+    draft_token_ids: torch.Tensor,
+    draft_probs: torch.Tensor,
+    target_probs: torch.Tensor,
+    output_token_ids: torch.Tensor,
+    cu_num_draft_tokens: torch.Tensor,
+    num_draft_tokens: list[int],
+) -> torch.Tensor:
+    """[num_tokens] bool: True where autoguard.decide() asks for strict
+    verification. Frozen wrapper -- warmup-batch guard, exception safety,
+    shape/dtype/device coercion, round-index bookkeeping -- around the
+    editable decide(). Any failure degrades to an all-False mask (i.e. plain
+    spec-casc-tok behaviour), never a crash."""
+    global _autoguard_warned
+    all_false = torch.zeros_like(draft_token_ids, dtype=torch.bool)
+    # vLLM warmup / CUDA-graph capture drives this with hundreds of synthetic
+    # sequences; real serving here is one request. Matches relaxation_trace.py's
+    # own _MAX_REAL_BATCH filter exactly.
+    if len(num_draft_tokens) > 8:
+        return all_false
+    try:
+        mask = _autoguard.decide(
+            round_index=_AUTOGUARD_STATE["round_index"],
+            committed_token_ids=_AUTOGUARD_HISTORY,
+            draft_token_ids=draft_token_ids,
+            draft_probs=draft_probs,
+            target_probs=target_probs,
+            num_draft_tokens=num_draft_tokens,
+            vocab_size=target_probs.shape[-1],
+        )
+        mask = mask.to(device=draft_token_ids.device, dtype=torch.bool).reshape(-1)
+        if mask.shape != draft_token_ids.shape:
+            raise ValueError(f"decide() returned shape {tuple(mask.shape)}, expected {tuple(draft_token_ids.shape)}")
+        return mask.contiguous()
+    except Exception as exc:  # noqa: BLE001 -- a broken decide() must not take the server down
+        if not _autoguard_warned:
+            print(f"[SPEC-CASC-TOK-AUTOGUARD PATCH] decide() raised, falling back to no-op mask: {exc!r}", file=sys.stderr, flush=True)
+            _autoguard_warned = True
+        return all_false
+
+
+def _autoguard_observe(
+    output_token_ids: torch.Tensor,
+    cu_num_draft_tokens: torch.Tensor,
+    num_draft_tokens: list[int],
+) -> None:
+    """Append request 0's freshly committed tokens to _AUTOGUARD_HISTORY and
+    advance the round counter. Called once per round, after the kernel."""
+    if len(num_draft_tokens) > 8:
+        return
+    _AUTOGUARD_STATE["round_index"] += 1
+    try:
+        row = output_token_ids[0].tolist()
+    except Exception:  # noqa: BLE001
+        return
+    for tok in row:
+        if tok is not None and tok >= 0:
+            _AUTOGUARD_HISTORY.append(int(tok))
+    if len(_AUTOGUARD_HISTORY) > _AUTOGUARD_HISTORY_CAP:
+        del _AUTOGUARD_HISTORY[: len(_AUTOGUARD_HISTORY) - _AUTOGUARD_HISTORY_CAP]
+
+
+print(
+    f"[SPEC-CASC-TOK-AUTOGUARD PATCH] pid={os.getpid()} alpha={_SPEC_CASC_TOK_ALPHA} "
+    f"({_SPEC_CASC_TOK_ALPHA_SOURCE}) autoguard={_autoguard.__file__}",
+    file=sys.stderr,
+    flush=True,
+)
+
