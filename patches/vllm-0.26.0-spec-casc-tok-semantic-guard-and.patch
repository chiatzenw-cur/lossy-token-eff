+print(
+    f"[SPEC-CASC-TOK-SEMANTIC-GUARD-AND PATCH] pid={os.getpid()} alpha={_SPEC_CASC_TOK_ALPHA} "
+    f"({_SPEC_CASC_TOK_ALPHA_SOURCE}) guard_token_ids={len(_SEMANTIC_GUARD_TOKEN_IDS)}",
+    file=sys.stderr,
