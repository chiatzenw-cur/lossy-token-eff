+    with open(_SPEC_CASC_TOK_GUARD_AND_ALPHA_FILE) as _f:
+        _SPEC_CASC_TOK_ALPHA = float(_f.read().strip())
+    _SPEC_CASC_TOK_ALPHA_SOURCE = _SPEC_CASC_TOK_GUARD_AND_ALPHA_FILE
+except (OSError, ValueError):
+    _SPEC_CASC_TOK_ALPHA = float("-inf")
+    _SPEC_CASC_TOK_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_TOK_GUARD_AND_ALPHA_FILE}"
