+# LOSSY-VERIFICATION PILOT PATCH (not upstream vLLM).
+#
+# Speculative Cascades [OPT] restricted to the verifier's HEAD
+# (spec-casc-opt-head). This repo's own hybrid of its spec-casc-opt and
+# spec-casc-tok rules, two knobs:
+#
+#   opt_defer     iff  max_u q(u) < max_u p(u) - alpha * TV(p, q)     (spec-casc-opt, Eq. 10)
+#   outside_head  iff  p(x) < (1 - beta) * max_w p(w)                  (spec-casc-tok's set A, Eq. 15)
+#   defer         iff  opt_defer OR outside_head
+#   accept        iff  defer and p(x)/q(x) >= u,  OR  not defer (always)
+#
+# Why: spec-casc-opt trusts the drafter WHOLESALE at confident positions --
+# it never looks at p(x) of the token actually drafted, so a drafted token
+# the verifier considers unlikely still gets a free pass. The campaign's
+# hypothesis (cascade/README.md) is that exactly those commits drive length
+# inflation. This variant keeps opt's trigger but only grants the free pass
+# inside the verifier's trusted top set; outside it, the strict test runs.
+# At beta = 1 the head is the whole vocabulary and this is plain
+# spec-casc-opt; at alpha -> -inf every position defers regardless of beta
+# (strict). beta in (-inf, 1].
+#
+# Only the accept test changes; residual sampling is stock p. Kernel hunk
+# byte-identical to spec-casc-opt's. The tracer records alpha as this arm's
+# scalar knob; beta is only in the server log line and the run directory
+# name (params suffix _beta<value>).
+#
+# Both knobs come from files, not the environment: vLLM spawns EngineCore
+# with a sanitised environment, so env vars never reach the sampler (see
+# the other patches' identical note). Paths are uid-scoped under /tmp.
+_SPEC_CASC_OPT_HEAD_ALPHA_FILE = f"/tmp/lossy-token-eff-spec-casc-opt-head-alpha-{os.getuid()}"
+try:
+    with open(_SPEC_CASC_OPT_HEAD_ALPHA_FILE) as _f:
+        _SPEC_CASC_OPT_HEAD_ALPHA = float(_f.read().strip())
+    _SPEC_CASC_OPT_HEAD_ALPHA_SOURCE = _SPEC_CASC_OPT_HEAD_ALPHA_FILE
+except (OSError, ValueError):
+    _SPEC_CASC_OPT_HEAD_ALPHA = float("-inf")  # always defer -> exactly strict spec-dec
+    _SPEC_CASC_OPT_HEAD_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_OPT_HEAD_ALPHA_FILE}"
+print(
+    f"[SPEC-CASC-OPT-HEAD PATCH] pid={os.getpid()} alpha={_SPEC_CASC_OPT_HEAD_ALPHA} "
+    f"({_SPEC_CASC_OPT_HEAD_ALPHA_SOURCE})",
+    file=sys.stderr,
+    flush=True,
+)
+
+_SPEC_CASC_OPT_HEAD_BETA_FILE = f"/tmp/lossy-token-eff-spec-casc-opt-head-beta-{os.getuid()}"
+try:
+    with open(_SPEC_CASC_OPT_HEAD_BETA_FILE) as _f:
+        _SPEC_CASC_OPT_HEAD_BETA = float(_f.read().strip())
+    _SPEC_CASC_OPT_HEAD_BETA_SOURCE = _SPEC_CASC_OPT_HEAD_BETA_FILE
