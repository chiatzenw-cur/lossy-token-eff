+
+def _rv_write_trace(record: dict[str, object]) -> None:
+    if not _RV_TRACE_DEST:
+        return
+    import json
+
+    with open(_RV_TRACE_DEST, "a", encoding="utf-8") as f:
+        f.write(json.dumps(record) + "\n")
+
+
+_RV_STATE: dict[str, object] = {"committed_before": 0}
+_RV_WARMUP_BATCH_THRESHOLD = 8
+
+
+def _rv_update(output_token_ids: torch.Tensor, batch_size: int) -> None:
+    """Cross-round persistence for the running committed-token count only,
+    used to annotate the trace -- same convention as free-judgment's own
+    _free_judgment_update. No mode/state machine here at all: every
+    round's blend is a stateless function of that round's own logits."""
+    state = _RV_STATE
+    if batch_size > _RV_WARMUP_BATCH_THRESHOLD:
+        state["committed_before"] = 0
+        return
+    row = output_token_ids[0].tolist()
+    emitted = [t for t in row if t != PLACEHOLDER_TOKEN_ID]
+    if not emitted:
+        return
+    state["committed_before"] = int(state["committed_before"]) + len(emitted)
+
+
+def _rv_apply(
+    target_logits: torch.Tensor,
+    target_probs: torch.Tensor,
+    draft_token_ids: torch.Tensor,
+    num_draft_tokens: list[int],
+    cu_num_draft_tokens: torch.Tensor,
+) -> torch.Tensor:
+    """Returns possibly-modified target_probs (a NEW tensor when the blend
+    fires, the ORIGINAL tensor unchanged otherwise -- same convention as
+    this repo's other guard/judgment patches). At the real draft
+    positions, replaces target_probs with softmax((1-alpha)*z0 +
+    alpha*z_reflect) where z0 is that position's own logits and z_reflect
+    is the logits at the SAME position index within the duplicate-draft
+    span (see gpu_model_runner.py's own module comment for the round
+    layout -- the duplicate span is a literal copy of the real tokens, so
+    position i in each span is directly comparable). Always bans the
+    reflection-prompt span's own first token (guarantees it's never
+    committed, same mechanism as free-judgment's criterion ban) so the
+    round can accept 0..REAL_DRAFT_LEN of the (now blended) real
+    positions, then always stops there -- nothing from the reflection
+    prompt or duplicate span ever reaches real output."""
+    if _RV_REAL_DRAFT_LEN <= 0 or not num_draft_tokens or num_draft_tokens[0] == 0:
+        return target_probs
+    n0 = num_draft_tokens[0]
+    total_needed = 2 * _RV_REAL_DRAFT_LEN + _RV_REFLECT_PROMPT_LEN
+    if n0 < total_needed:
+        return target_probs
+    end0 = int(cu_num_draft_tokens[0].item())
+    start0 = end0 - n0
+    prompt_start_row = start0 + _RV_REAL_DRAFT_LEN
+    dup_start_row = prompt_start_row + _RV_REFLECT_PROMPT_LEN
+
+    z0 = target_logits[start0:start0 + _RV_REAL_DRAFT_LEN]
+    z_reflect = target_logits[dup_start_row:dup_start_row + _RV_REAL_DRAFT_LEN]
+    z_mix = (1.0 - _RV_ALPHA) * z0 + _RV_ALPHA * z_reflect
+    p_mix = z_mix.softmax(dim=-1, dtype=torch.float32)
+
+    new_probs = target_probs.clone()
+    new_probs[start0:start0 + _RV_REAL_DRAFT_LEN] = p_mix
+
+    banned_tok = int(draft_token_ids[prompt_start_row].item())
+    new_probs[prompt_start_row, banned_tok] = 0.0
+    row_sum = new_probs[prompt_start_row].sum().clamp_min(1e-30)
+    new_probs[prompt_start_row] = new_probs[prompt_start_row] / row_sum
+
+    # Diagnostic only (not used for the blend or any decision): compare
+    # what the LAST real position's own top token would have been with
+    # vs without the reflection nudge, to see offline whether the blend
+    # is actually steering anything or just adding noise. Token ids only
+    # here (no decoding in the hot path); decode offline.
+    last = _RV_REAL_DRAFT_LEN - 1
+    z0_top_prob, z0_top_id = z0[last].softmax(dim=-1, dtype=torch.float32).max(dim=-1)
+    mix_top_prob, mix_top_id = p_mix[last].max(dim=-1)
+    _rv_write_trace(
+        {
+            "committed_before_this_round": _RV_STATE["committed_before"],
+            "alpha": _RV_ALPHA,
+            "z0_top_id": int(z0_top_id.item()),
+            "z0_top_prob": round(z0_top_prob.item(), 6),
+            "mix_top_id": int(mix_top_id.item()),
+            "mix_top_prob": round(mix_top_prob.item(), 6),
+            "top_changed": bool(z0_top_id.item() != mix_top_id.item()),
+        }
+    )
+    return new_probs
+
