+except (OSError, ValueError):
+    _RV_ALPHA = 0.3  # Reflective Verification's own default (arXiv:2505.18629)
+
+_RV_TRACE_PATH_FILE = f"/tmp/lossy-token-eff-rv-trace-path-{os.getuid()}"
+try:
+    with open(_RV_TRACE_PATH_FILE) as _f:
+        _RV_TRACE_DEST = _f.read().strip() or None
+except OSError:
+    _RV_TRACE_DEST = None
