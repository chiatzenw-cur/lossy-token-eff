+    f"[SPEC-CASC-TOK PATCH] pid={os.getpid()} alpha={_SPEC_CASC_TOK_ALPHA} "
+    f"({_SPEC_CASC_TOK_ALPHA_SOURCE})",
+    file=sys.stderr,
+    flush=True,
