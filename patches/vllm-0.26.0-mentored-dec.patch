 from vllm.triton_utils import tl, tldevice, triton
 from vllm.v1.worker.gpu.sample.gumbel import gumbel_block_argmax, tl_rand32
 
+# LOSSY-VERIFICATION PILOT PATCH (not upstream vLLM).
+#
+# Mentored Decoding (Tran-Thien 2023, beta=1 variant; "mentored-dec" in Xia
+# et al. 2026's taxonomy, arXiv:2607.08690 Table 2 / Eq. 9). See the sibling
+# V1 file (vllm/v1/sample/rejection_sampler.py) for the full derivation and
+# the exactness argument for using the unclamped ratio. Summary: writing
+# lam = 1 - alpha,
+#     strict         accept iff  p(x)/q(x)        > u
+#     mentored-dec   accept iff  p(x)/(lam*q(x))  > u
+#
+# The kernel already works in log space, so this is one additive term:
+#     log p > log u + log q + log(lam)
+# log(lam) <= 0, so a smaller lam (larger alpha) lowers the bar and accepts
+# more draft tokens. alpha == 0 gives lam == 1.0 and log(lam) == 0.0 exactly,
+# and `x > y + 0.0` is bit-identical to `x > y` in IEEE754, so the strict
+# control arm is unaffected by this expression (the kernel is still
+# recompiled with an extra argument, so equivalence of the whole run is an
+# empirical claim, not a proof).
+#
+# Naming: alpha is the taxonomy's own relaxation-parameter symbol (Xia et al.
+# glossary: "meaning is method-dependent"). Tran-Thien's own beta is a
+# different, fixed-at-1 parameter and does not appear here -- an earlier
+# version of this patch called the knob "beta", which collided with that and
+# was renamed to "lenience factor" (lam) and now to alpha, matching the CLI
+# surface to the taxonomy table directly.
+#
+# alpha is read from a FILE, not an environment variable. vLLM spawns its
+# EngineCore worker with a sanitised environment: the env var was verified
+# present in the API server's /proc/<pid>/environ and absent from EngineCore's,
+# so any env-var channel silently leaves alpha at 0.0 and the lossy arm
+# becomes an unlabelled copy of the strict arm. That failure produced two bogus
+# datasets before it was caught (in the lenience-named predecessor of this
+# patch), so the value is logged loudly at import.
+#
+# The path is uid-scoped under /tmp AND repo-scoped (lossy-token-eff), not
+# repo-relative: a hardcoded clone path desynchronises the writer
+# (run_server_vllm.sh) from this reader as soon as someone clones to a
+# different directory, and the repo-scoped prefix keeps this repo's server
+# from picking up a stale value written by the sibling
+# lossy-spec-decode-repetition repo's own (differently-prefixed) knob file if
+# both ever run on this box at once.
+_MENTORED_DEC_ALPHA_FILE = f"/tmp/lossy-token-eff-mentored-dec-alpha-{os.getuid()}"
+try:
+    with open(_MENTORED_DEC_ALPHA_FILE) as _f:
+        _MENTORED_DEC_ALPHA = float(_f.read().strip())
+    _MENTORED_DEC_ALPHA_SOURCE = _MENTORED_DEC_ALPHA_FILE
+except (OSError, ValueError):
+    _MENTORED_DEC_ALPHA = 0.0  # lam == 1.0 -> strict spec-dec exactly
+    _MENTORED_DEC_ALPHA_SOURCE = f"default, no readable {_MENTORED_DEC_ALPHA_FILE}"
+if not 0.0 <= _MENTORED_DEC_ALPHA < 1.0:
+    raise ValueError(f"mentored-dec alpha must be in [0, 1); got {_MENTORED_DEC_ALPHA}")
+_MENTORED_DEC_LAM = 1.0 - _MENTORED_DEC_ALPHA
+_MENTORED_DEC_LOG_LAM = math.log(_MENTORED_DEC_LAM)
+# stderr, not stdout: run_server_vllm.sh probes this module by capturing
+# stdout, and an extra line there breaks the check.
+print(
+    f"[MENTORED-DEC PATCH] pid={os.getpid()} alpha={_MENTORED_DEC_ALPHA} "
+    f"lam={_MENTORED_DEC_LAM} log_lam={_MENTORED_DEC_LOG_LAM} "
+    f"({_MENTORED_DEC_ALPHA_SOURCE})",
+    file=sys.stderr,
+    flush=True,
+)
