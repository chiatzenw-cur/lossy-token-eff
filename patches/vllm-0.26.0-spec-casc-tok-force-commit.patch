+# LOSSY-VERIFICATION PILOT PATCH (not upstream vLLM).
+#
+# Speculative Cascades [Tok] (spec-casc-tok), Narasimhan et al. 2025 appendix
+# ("Faster Cascades via Speculative Decoding"), as unified into Xia et al.
+# 2026's taxonomy (arXiv:2607.08690 Appendix B, Eq. 15). Keeps the drafter's
+# own mass within a "trusted top set" of the verifier, and fills in the rest
+# (both outside that set, and whatever mass the drafter didn't already cover
+# inside it) with a rescaled verifier distribution:
+#
+#   pi_rej(v) = pi_res(v) = q(v) + eta*p(v)   if v in A
+#                          = eta*p(v)          otherwise
+#   A   = {u : p(u) >= (1-alpha) * max_w p(w)}     (trusted top set)
+#   eta = 1 - sum_{u in A} q(u)                    (mass NOT covered by q on A)
+#
+# This is a genuine full-vocab BLEND, not a wholesale switch between q and p
+# like this repo's spec-casc-opt/r-fuzzy patches -- pi_rej(x)/q(x) is not
+# generally 0 or 1, so (like this repo's cactus patch, and unlike
+# spec-casc-opt/r-fuzzy) this DOES need to touch recovery/residual sampling,
+# not just the accept/reject test.
+#
+# alpha=0 does NOT recover strict spec-dec here, unlike every other method in
+# this repo. At alpha=0, A = {argmax_w p(w)} (only the verifier's own top
+# token), and eta = 1 - q(argmax p) -- i.e. pi_rej already differs from p
+# unless q happens to put ALL its mass on the verifier's own top token. The
+# actual strict limit is alpha -> -inf: (1-alpha) -> +inf, so the threshold
+# (1-alpha)*max_w p(w) exceeds every p(u) (for any row with max_w p(w) > 0,
+# which is every row), A becomes empty, eta = 1 - 0 = 1, and pi_rej(v) =
+# 1*p(v) = p(v) for all v -- exactly strict. Xia et al.'s own Appendix B
+# flags this discontinuity and omits the method from their main-body results
+# partly because of it; this repo's other four patches all use alpha=0 (or
+# -inf, for the two that use -inf as their strict point) as their safe
+# missing-config default, so getting THIS one's default right (-inf, not 0)
+# is the one place that convention needs an explicit exception, not a copy.
+#
+# Implementation: A and eta are full-vocab reductions (a max and a masked
+# sum), computed once in plain PyTorch before kernel launch -- same
+# pre-reduction style as this repo's spec-casc-opt/r-fuzzy defer_mask -- and
+# passed into the accept kernel as two per-token scalar arrays (eta, and the
+# verifier's own top1 probability, from which A's membership for the drafted
+# token x alone is cheap to test in-kernel: p(x) >= (1-alpha)*top1). The
+# FULL pi_rej tensor (needed for residual sampling over the whole vocab, not
+# just x) is also built here in plain PyTorch and substituted for
+# target_probs in the call to sample_recovered_tokens, exactly the H_x
+# pattern this repo's cactus patch uses.
+#
+# alpha comes from a file, not the environment (vLLM spawns EngineCore with a
+# sanitised environment; env vars never reach it), uid-scoped AND repo-scoped
+# under /tmp so a server from the sibling lossy-spec-decode-repetition repo
+# cannot pick up this repo's (differently-prefixed) knob value if both ever
+# run on this box at once. Own file, not plain spec-casc-tok's -- aliasing it
+# was a real bug caught once already building spec-casc-tok-antiloop (a
+# plain spec-casc-tok server on the same box would otherwise silently share/
+# clobber this derived method's alpha knob); not repeating it here.
+_SPEC_CASC_TOK_FORCE_COMMIT_ALPHA_FILE = f"/tmp/lossy-token-eff-spec-casc-tok-force-commit-alpha-{os.getuid()}"
+try:
+    with open(_SPEC_CASC_TOK_FORCE_COMMIT_ALPHA_FILE) as _f:
+        _SPEC_CASC_TOK_ALPHA = float(_f.read().strip())
+    _SPEC_CASC_TOK_ALPHA_SOURCE = _SPEC_CASC_TOK_FORCE_COMMIT_ALPHA_FILE
+except (OSError, ValueError):
+    # NOT 0.0 -- see the module comment above. -inf empties the trusted top
+    # set entirely, which is the actual strict point for this method.
+    _SPEC_CASC_TOK_ALPHA = float("-inf")
+    _SPEC_CASC_TOK_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_TOK_FORCE_COMMIT_ALPHA_FILE}"
+print(
+    f"[SPEC-CASC-TOK-FORCE-COMMIT PATCH] pid={os.getpid()} alpha={_SPEC_CASC_TOK_ALPHA} "
+    f"({_SPEC_CASC_TOK_ALPHA_SOURCE})",
+    file=sys.stderr,
+    flush=True,
+)
+
+# FORCE-COMMIT (analysis/semantic_guard/, not upstream vLLM, not part of Xia
+# et al.'s taxonomy). Reactive budget-exhaustion breaker for a THIRD failure
+# shape this investigation found distinct from both token-level repetition
+# (spec-casc-tok-antiloop's target) and macro-loop channel-restart: "never
+# commits" -- the model stays inside the harmony `analysis` channel,
+# re-deriving/re-verifying the same conclusions in genuinely different
+# words each cycle (no exact token-level OR even long-range exact-substring
+# recurrence -- checked directly, n-gram duplicate coverage at 30/60-token
+# windows is ~0 on these cases, ruling out a generalized antiloop as a fix),
+# and simply runs out the generation budget without ever opening a `final`
+# -channel message. Confirmed on 4 of 31 real AIME24 cases checked across
+# two arms/sweeps (~13%, not a rare fluke of one case) via
+# find_macro_loop_restarts.py's own FINAL_OPEN_PATTERN detection. This is
+# the worst possible outcome for a benchmark run: maximum tokens spent,
+# zero extractable answer (no_answer, not even a wrong one).
+#
+# Four independently-designed local per-token signals were tried in this
+# investigation as EARLY predictors of this kind of unproductive generation
+# (window-entropy ramp, sustained target-confidence dip, hesitation-word
+# density, and -- from earlier hidden-state-recurrence work, see
+# analysis/semantic_guard/README.md's "Does recurrence predict
+# 'unproductive' generation in general?" section -- continuous hidden-state
+# recurrence against four proxies including one real ground-truth span).
+# ALL FOUR fail or are too weak to act on, and the hidden-state one fails in
+# a structurally identical way to the others: it spikes AT a loop-back
+# boundary, not during the unproductive content leading up to it
+# ("ignition, not maintenance"). No local signal in this investigation
+# reliably tells you, while it's happening, that the current content is
+# heading nowhere.
+#
+# So this patch does not try to predict "unproductive" at all. It reacts to
+# a fact known with certainty and zero ambiguity: cumulative real emitted
+# token count for this sequence, and whether the fixed 6-token
+# `<|end|><|start|>assistant<|channel|>final<|message|>` boundary has
+# occurred yet in this sequence's own emitted history (same literal pattern
+# find_macro_loop_restarts.py already validated: exact special-token ids,
+# not decoded text, for exactness). Once cumulative tokens cross a
+# threshold AND final has not naturally opened, FORCE it: one-hot
+# target_probs onto the next pattern token at the first drafted position
+# each round (a draft token that doesn't match is a guaranteed strict
+# rejection -- target_prob=0 there since everything else was zeroed -- which
+# terminates the round immediately per this repo's universal "stop at first
+# rejection" behavior, so recovery sampling picks up the one-hot pi_rej mass
+# and the round emits the forced token; a round naturally advances the
+# pattern by exactly one token per round this way). Progress is read back
+# from the ACTUAL emitted history after each round (longest suffix matching
+# a pattern prefix), never assumed -- self-correcting and idempotent by
+# construction, same "ground truth from output_token_ids, not the round's
+# own optimistic assumption" convention as spec-casc-tok-antiloop's history
+# update. Once the full pattern has actually appeared anywhere in the
+# emitted history (forced or natural), this is permanently a no-op for the
+# rest of that sequence: normal generation inside `final` is never touched.
+# Threshold is well below the 32768-token cap used throughout this
+# investigation's AIME24 runs, but comfortably above nearly every case's
+# own natural commit point (median case commits under ~10k tokens; only
+# case_003 in the 30-case future-guard sweep commits as late as 31509/32482
+# naturally -- a known, disclosed tradeoff this threshold may cut into,
+# to be measured empirically, not assumed away).
+_FORCE_COMMIT_THRESHOLD_FILE = f"/tmp/lossy-token-eff-spec-casc-tok-force-commit-threshold-{os.getuid()}"
+try:
+    with open(_FORCE_COMMIT_THRESHOLD_FILE) as _f:
+        _FORCE_COMMIT_THRESHOLD = int(float(_f.read().strip()))
+except (OSError, ValueError):
+    _FORCE_COMMIT_THRESHOLD = 28000
+print(
+    f"[SPEC-CASC-TOK-FORCE-COMMIT PATCH] pid={os.getpid()} "
+    f"threshold={_FORCE_COMMIT_THRESHOLD}",
+    file=sys.stderr,
+    flush=True,
+)
+
+# Harmony special/plain token ids for the `final`-channel-open boundary,
+# same ids find_macro_loop_restarts.py looked up once via get_encoding()
+# against the fixed o200k_harmony vocab and documented as stable:
+#   <|end|>=200007  <|start|>=200006  <|channel|>=200005  <|message|>=200008
+#   "assistant"=173781  "final"=17196
+_FINAL_OPEN_PATTERN = [200007, 200006, 173781, 200005, 17196, 200008]
+_FORCE_COMMIT_WARMUP_BATCH_THRESHOLD = 8  # matches this repo's other cross-round-state patches
+_FORCE_COMMIT_HISTORY_MAXLEN = 64  # >= 2*len(_FINAL_OPEN_PATTERN) with wide margin
+
+_FORCE_COMMIT_STATE: dict[str, object] = {
+    "token_count": 0,  # cumulative real emitted tokens, this sequence
+    "final_opened": False,  # sticky: True once the pattern has ever completed (natural or forced)
+    "tail": [],  # last <=_FORCE_COMMIT_HISTORY_MAXLEN real emitted token ids
+}
+
+
+def _force_commit_pattern_progress(tail: list[int]) -> int:
+    """Longest suffix of `tail` that equals a (possibly full) prefix of
+    _FINAL_OPEN_PATTERN -- i.e. how many pattern tokens are already
+    confirmed emitted, in order, at the current tail. 0 if no suffix
+    matches even the first pattern token."""
+    n = len(_FINAL_OPEN_PATTERN)
+    for k in range(min(n, len(tail)), 0, -1):
+        if tail[-k:] == _FINAL_OPEN_PATTERN[:k]:
+            return k
+    return 0
+
+
+def _force_commit_apply(
+    target_probs: torch.Tensor,
+    num_draft_tokens: list[int],
+    cu_num_draft_tokens: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Returns (possibly-forced target_probs, force_mask). force_mask is
+    [num_tokens] bool, True at every forced position this round (if any) --
+    purely informational, same convention as this repo's other guards'
+    token_marker_guard_mask. Never mutates the caller's target_probs in
+    place; returns the ORIGINAL tensor unchanged when not forcing (the
+    common case for the vast majority of tokens in the vast majority of
+    sequences).
+
+    Forces EVERY still-unforced pattern position available in this round,
+    not just the first (start0) -- a real bug caught live on
+    spec-casc-tok-self-check (which shares this exact forcing code shape):
+    if start0's forced token happens to be genuinely ACCEPTED (the draft's
+    own proposal coincides with it), the round does not terminate the way
+    a force-rejection always does, so it continues to this round's later
+    positions with fully unforced target_probs -- natural content leaks in
+    and can diverge from the pattern mid-force, and the next round's
+    tail-based readback then restarts the pattern from 0. Forcing the
+    round's full available span (min(this round's draft length, pattern
+    tokens remaining)) closes this."""
+    state = _FORCE_COMMIT_STATE
+    num_tokens = target_probs.shape[0]
+    force_mask = torch.zeros(num_tokens, dtype=torch.bool, device=target_probs.device)
+    if state["final_opened"] or state["token_count"] < _FORCE_COMMIT_THRESHOLD:
+        return target_probs, force_mask
+    # Only slot 0 carries real persistent history -- see this repo's
+    # future-guard/antiloop patches' own module comments for the
+    # single-real-sequence-per-process scoping this relies on.
+    if not num_draft_tokens or num_draft_tokens[0] == 0:
+        return target_probs, force_mask
+    end0 = int(cu_num_draft_tokens[0].item())
+    n0 = num_draft_tokens[0]
+    start0 = end0 - n0
+    progress = _force_commit_pattern_progress(state["tail"])  # in [0, 6)
+    remaining = len(_FINAL_OPEN_PATTERN) - progress
+    if remaining <= 0:
+        return target_probs, force_mask
+    n_to_force = min(n0, remaining)
+    forced = target_probs.clone()
+    for i in range(n_to_force):
+        pos = start0 + i
+        forced_token = _FINAL_OPEN_PATTERN[progress + i]
+        forced[pos] = 0.0
+        forced[pos, forced_token] = 1.0
+        force_mask[pos] = True
+    return forced, force_mask
+
+
+def _force_commit_update(
+    output_token_ids: torch.Tensor,
+    num_draft_tokens: list[int],
+    batch_size: int,
+) -> None:
+    """Cross-round persistence: append whatever ACTUALLY got emitted this
+    round (ground truth, not an optimistic assumption) to the running
+    token count and tail buffer, and check whether the full pattern has now
+    appeared. Same warmup-batch reset convention as this repo's
+    spec-casc-tok-antiloop patch."""
+    state = _FORCE_COMMIT_STATE
+    if batch_size > _FORCE_COMMIT_WARMUP_BATCH_THRESHOLD:
+        state["token_count"] = 0
+        state["final_opened"] = False
+        state["tail"] = []
+        return
+    row = output_token_ids[0].tolist()
+    emitted = [t for t in row if t != PLACEHOLDER_TOKEN_ID]
+    if not emitted:
+        return
+    state["token_count"] = int(state["token_count"]) + len(emitted)
+    if state["final_opened"]:
+        return
+    tail = list(state["tail"]) + emitted
+    if len(tail) > _FORCE_COMMIT_HISTORY_MAXLEN:
+        del tail[: len(tail) - _FORCE_COMMIT_HISTORY_MAXLEN]
+    state["tail"] = tail
+    if _force_commit_pattern_progress(tail) >= len(_FINAL_OPEN_PATTERN):
+        state["final_opened"] = True
+
