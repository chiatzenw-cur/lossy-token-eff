+# LOSSY-VERIFICATION PILOT PATCH (not upstream vLLM).
+#
+# Speculative Cascades with CHOW'S RULE as the deferral rule (spec-casc-chow),
+# Narasimhan et al. 2025 Eq. 2 -- the classic cascade rule that looks at the
+# small model's confidence alone:
+#
+#   defer  iff  max_u q(u) < 1 - alpha
+#   accept iff  defer and p(x)/q(x) >= u,  OR  not defer (always)
+#
+# alpha in (-inf, 1]: alpha -> -inf makes the threshold +inf so every
+# position defers (exactly strict spec-dec); alpha = 0.5 trusts the drafter
+# wherever its top token has probability >= 0.5; alpha = 1 never defers.
+# The only cascade rule here that never consults the verifier's distribution
+# for the decision -- p enters only through the strict test on deferred
+# positions. Only the accept test changes; residual sampling is stock p.
+# Kernel hunk byte-identical to spec-casc-opt's.
+#
+# The alpha value comes from a file, not the environment: vLLM spawns
+# EngineCore with a sanitised environment, so env vars never reach the
+# sampler (see the other patches' identical note). The path is uid-scoped
+# under /tmp so a clone in any directory agrees with the server script.
+_SPEC_CASC_CHOW_ALPHA_FILE = f"/tmp/lossy-token-eff-spec-casc-chow-alpha-{os.getuid()}"
+try:
+    with open(_SPEC_CASC_CHOW_ALPHA_FILE) as _f:
+        _SPEC_CASC_CHOW_ALPHA = float(_f.read().strip())
+    _SPEC_CASC_CHOW_ALPHA_SOURCE = _SPEC_CASC_CHOW_ALPHA_FILE
+except (OSError, ValueError):
+    _SPEC_CASC_CHOW_ALPHA = float("-inf")  # always defer -> exactly strict spec-dec
+    _SPEC_CASC_CHOW_ALPHA_SOURCE = f"default, no readable {_SPEC_CASC_CHOW_ALPHA_FILE}"
+print(
+    f"[SPEC-CASC-CHOW PATCH] pid={os.getpid()} alpha={_SPEC_CASC_CHOW_ALPHA} "
+    f"({_SPEC_CASC_CHOW_ALPHA_SOURCE})",
+    file=sys.stderr,
+    flush=True,
+)
 
