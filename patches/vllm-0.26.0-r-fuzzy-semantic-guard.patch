+# LOSSY-VERIFICATION PILOT PATCH (not upstream vLLM).
+#
+# (Reducible) Fuzzy Speculative Decoding (r-fuzzy), Holsman et al. 2025,
+# "Fuzzy speculative decoding for a tunable accuracy-runtime tradeoff", as
+# unified into Xia et al. 2026's taxonomy (arXiv:2607.08690 Eq. 10, Table 2).
+# Per position, either trust the drafter completely or run the strict test:
+#
+#   pi_rej(v) = pi_res(v) = q(v)  if Div(p, q) < alpha
+#                          = p(v)  otherwise
+#
+# Div is Jensen-Shannon divergence, the paper's own recommendation (avoids
+# the divide-by-zero KL-divergence can hit under non-overlapping top-p/top-k
+# support). alpha -> -inf makes "Div < alpha" always false, recovering strict
+# spec-dec exactly (same convention as this repo's spec-casc-opt patch);
+# alpha -> +inf always trusts q.
+#
+# Reducible, not the paper's own "fuzzy": the paper's own presentation picks
+# q or p by the divergence test and samples directly from whichever is
+# picked. That is equivalent in distribution to running the *ordinary*
+# accept/residual machinery with the same target (q or p) substituted in --
+# Xia et al. prove this in their Appendix C (Result 1) and additionally show
+# the reducible form has provably-greater-or-equal per-token acceptance for
+# the SAME output distribution, since when the target is q, this substitution
+# accepts the drafted token outright (pi_rej(x)/q(x) == 1) instead of
+# resampling from q "from scratch". This patch implements only the reducible
+# form, per that result.
+#
+# Structurally this mirrors the spec-casc-opt patch in this repo almost
+# exactly: both binary-switch the whole per-token target between q and p
+# based on a full-vocab reduction computed once in plain PyTorch before
+# kernel launch (a JS divergence here, TV/argmax there), passed in as a
+# boolean per-token mask. Neither ever blends q and p, and picking q always
+# means "accept unconditionally" (pi_rej(x)/q(x) == 1), so -- like
+# spec-casc-opt -- this patch does NOT need to touch recovery/residual
+# sampling: rejection can only happen on the strict-test branch, where the
+# residual target is p, already vLLM's stock behaviour.
+#
+# alpha comes from a file, not the environment (vLLM spawns EngineCore with a
+# sanitised environment; env vars never reach it), uid-scoped AND repo-scoped
+# under /tmp so a server from the sibling lossy-spec-decode-repetition repo
+# cannot pick up this repo's (differently-prefixed) knob value if both ever
+# run on this box at once. This variant's own file, not plain r-fuzzy's --
+# they must never alias, or the "other arms sit at their strict value" check
+# in scripts/run_experiment_vllm.py's acceptance_rule_record() would read a
+# stale non-strict value through the wrong method's name (or, worse, this
+# variant would silently pick up whatever plain r-fuzzy last wrote).
+_R_FUZZY_ALPHA_FILE = f"/tmp/lossy-token-eff-r-fuzzy-semantic-guard-alpha-{os.getuid()}"
+try:
+    with open(_R_FUZZY_ALPHA_FILE) as _f:
+        _R_FUZZY_ALPHA = float(_f.read().strip())
+    _R_FUZZY_ALPHA_SOURCE = _R_FUZZY_ALPHA_FILE
+except (OSError, ValueError):
+    _R_FUZZY_ALPHA = float("-inf")  # Div < -inf is never true -> strict spec-dec
+    _R_FUZZY_ALPHA_SOURCE = f"default, no readable {_R_FUZZY_ALPHA_FILE}"
+
+# SEMANTIC GUARD (pilot experiment, analysis/semantic_guard/, not upstream
+# vLLM, not part of Xia et al.'s taxonomy -- a variant ON TOP of r-fuzzy, not
+# a new relaxation method). Hypothesis under test: hesitation/self-correction
+# marker tokens ("wait", "hmm", "actually", "but", "let's") are
+# disproportionately likely to seed later trajectory corruption when relaxed
+# acceptance lets one through that strict verification would have rejected --
+# see analysis/semantic_guard/README.md's "How many of these were accepted
+# only because of the relaxed verifier" section for the offline evidence
+# motivating this experiment (10-27% of hesitation words on the
+# worse-performing relaxed arms, r-fuzzy included, are relaxed-only-accepted
+# in the unguarded data already collected).
+#
+# At these specific token ids, force r-fuzzy's deferral decision to True (run
+# the strict p/q test) regardless of what the JSD divergence test below says,
+# leaving every other position's decision untouched -- an unconditional OR
+# into defer_mask, computed in plain PyTorch before the kernel launch. The
+# kernel itself (already reading defer_mask_ptr for plain r-fuzzy) needs no
+# changes at all; only the Python-side mask construction differs from
+# vllm-0.26.0-r-fuzzy.patch, hence this being its own patch file / HASHES.txt
+# label ("r-fuzzy-semantic-guard") rather than a runtime toggle on r-fuzzy
+# itself -- the same mutual-exclusion-by-file discipline every other pair of
+# arms here already uses.
+#
+# Token ids are the SINGLE-TOKEN forms of each marker as gpt-oss-20b's
+# o200k_harmony tokenizer actually encodes them mid-generation (i.e. WITH a
+# leading space, since that's how virtually every real occurrence appears --
+# a marker at the very start of a message/line, with no leading space, is
+# the rare multi-token exception and is not covered by this list):
+#   wait:      "wait"(29126) "Wait"(17114) " wait"(5238) " Wait"(24305)
+#   hmm:       "Hmm"(112576) " hmm"(186402) " Hmm"(165972)
+#   actually:  "actually"(138925) "Actually"(87471) " actually"(4771) " Actually"(50557)
+#   but:       "but"(8293) "But"(7943) " but"(889) " But"(3072)
+#   let's:     "Let's"(58369) " let's"(35717) " Let's"(41021)
+# Deliberately excludes bare "let"/" let" (not the contraction) -- extremely
+# common in ordinary math setup ("let s = speed"), guarding it would gut the
+# speed benefit for a token that is almost never actually a hesitation
+# marker. Re-derive with:
+#   from openai_harmony import load_harmony_encoding, HarmonyEncodingName
+#   enc = load_harmony_encoding(HarmonyEncodingName.HARMONY_GPT_OSS)
+#   enc.encode(" wait")  # etc., one call per surface form above
+_SEMANTIC_GUARD_TOKEN_IDS: tuple[int, ...] = (
+    29126, 17114, 5238, 24305,
+    112576, 186402, 165972,
+    138925, 87471, 4771, 50557,
+    8293, 7943, 889, 3072,
+    58369, 35717, 41021,
+)
+_semantic_guard_id_tensor_cache: dict[torch.device, torch.Tensor] = {}
+
+
+def _semantic_guard_mask(draft_token_ids: torch.Tensor) -> torch.Tensor:
+    """[num_tokens] bool: True where the drafted token is one of the
+    hesitation-marker ids above, regardless of round/position. Cached per
+    device (there is normally exactly one, the single serving GPU) so this
+    is one small `torch.isin` per verification round, not a fresh tensor
+    build."""
+    device = draft_token_ids.device
+    ids = _semantic_guard_id_tensor_cache.get(device)
+    if ids is None:
+        ids = torch.tensor(_SEMANTIC_GUARD_TOKEN_IDS, device=device, dtype=draft_token_ids.dtype)
+        _semantic_guard_id_tensor_cache[device] = ids
+    return torch.isin(draft_token_ids, ids)
+
+
+print(
+    f"[R-FUZZY-SEMANTIC-GUARD PATCH] pid={os.getpid()} alpha={_R_FUZZY_ALPHA} "
+    f"({_R_FUZZY_ALPHA_SOURCE}) guard_token_ids={len(_SEMANTIC_GUARD_TOKEN_IDS)}",
+    file=sys.stderr,
+    flush=True,
+)
+
