+    # draft_probs is unavailable (NO_DRAFT_PROBS): there is no q to compare
+    # against p, so the kernel keeps its original always-strict behaviour.
+    defer_mask: torch.Tensor | None = None
+    if draft_probs is not None:
+        _eps = 1e-12
+        m = 0.5 * (target_probs + draft_probs)
